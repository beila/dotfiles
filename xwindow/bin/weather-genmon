#!/bin/bash
# Weather genmon script for xfce4-panel
# Uses wttr.in API — no API key needed

weather_location='51.460,0.107'
weather_name='Welling, London'
json=$(curl -sf "https://wttr.in/${weather_location}?format=j1" 2>/dev/null)
if [ -z "$json" ]; then
    echo "<txt>☁ --</txt>"
    echo "<tool>Weather unavailable</tool>"
    exit 0
fi

read -r icon temp < <(echo "$json" | python3 -c "
import os,sys,json
from datetime import datetime
d=json.load(sys.stdin)
w=d['weather'][0]
cur=d['current_condition'][0]
icon=cur['weatherIconUrl'][0]['value']  # unused, use desc instead
desc=cur['weatherDesc'][0]['value'].strip().lower()
temp=cur['temp_C']
sr=w['astronomy'][0]['sunrise'].strip()
ss=w['astronomy'][0]['sunset'].strip()
now_value=os.environ.get('WEATHER_NOW')
now=datetime.fromisoformat(now_value) if now_value else datetime.now()
fmt='%I:%M %p'
sunrise=datetime.strptime(sr, fmt).replace(year=now.year, month=now.month, day=now.day)
sunset=datetime.strptime(ss, fmt).replace(year=now.year, month=now.month, day=now.day)
night = now > sunset or now < sunrise
def weather_icon(description, is_night):
    if 'thunder' in description:
        return '⛈'
    if 'snow' in description:
        return '❄️'
    if 'rain' in description or 'drizzle' in description:
        return '🌧'
    if 'fog' in description or 'mist' in description:
        return '🌫'
    if 'overcast' in description:
        return '☁️'
    if 'partly' in description or 'cloud' in description:
        return '☁🌙' if is_night else '⛅'
    if 'sun' in description or 'clear' in description:
        return '🌙' if is_night else '☀️'
    return '🌙' if is_night else '🌤'
e=weather_icon(desc, night)
print(e, f'{temp}°C')
" 2>/dev/null)

if [ -n "$temp" ]; then
    echo "<txt>${icon} ${temp}</txt>"
else
    echo "<txt>☁ --</txt>"
    echo "<tool>Weather unavailable</tool>"
    exit 0
fi

tooltip=$(echo "$json" | WEATHER_LOCATION_NAME="$weather_name" python3 -c "
import os,sys,json
from datetime import datetime
d=json.load(sys.stdin)
cur=d['current_condition'][0]
w=d['weather'][0]
loc=os.environ.get('WEATHER_LOCATION_NAME') or d['nearest_area'][0]['areaName'][0]['value']
cond=cur['weatherDesc'][0]['value'].strip()
temp=cur['temp_C']
feel=cur['FeelsLikeC']
hum=cur['humidity']
wind=cur['windspeedKmph']+'km/h '+cur['winddir16Point']
sr=w['astronomy'][0]['sunrise'].strip()
ss=w['astronomy'][0]['sunset'].strip()
print(f'{loc}  —  {cond}')
print()
print(f'🌡️ Temp:     {temp}°C (feels {feel}°C)')
print(f'💧 Humidity: {hum}%')
print(f'💨 Wind:     {wind}')
print(f'🌅 Sun:      {sr} – {ss}')
print()
print('📅 Forecast')
now_value=os.environ.get('WEATHER_NOW')
now=datetime.fromisoformat(now_value) if now_value else datetime.now()
today=now.date()
now_h=now.hour
fmt='%I:%M %p'
sunrise=datetime.strptime(sr, fmt)
sunset=datetime.strptime(ss, fmt)
sunrise_minutes=sunrise.hour*60+sunrise.minute
sunset_minutes=sunset.hour*60+sunset.minute
def weather_icon(description, is_night):
    description=description.strip().lower()
    if 'thunder' in description:
        return '⛈'
    if 'snow' in description:
        return '❄️'
    if 'rain' in description or 'drizzle' in description:
        return '🌧'
    if 'fog' in description or 'mist' in description:
        return '🌫'
    if 'overcast' in description:
        return '☁️'
    if 'partly' in description or 'cloud' in description:
        return '☁🌙' if is_night else '⛅'
    if 'sun' in description or 'clear' in description:
        return '🌙' if is_night else '☀️'
    return '🌙' if is_night else '🌤'
first=True
for h in w['hourly']:
    hour=int(h['time'])//100
    if hour<now_h: continue
    if first: print('Today'); first=False
    desc=h['weatherDesc'][0]['value'].strip()
    minutes=hour*60
    icon=weather_icon(desc, minutes<sunrise_minutes or minutes>=sunset_minutes)
    print(f\"  {hour:02d}:00    {h['tempC']:>3}°C  {icon}  rain {h['chanceofrain']:>3}%  {desc}\")
for day in d['weather'][1:3]:
    dt=datetime.strptime(day['date'],'%Y-%m-%d').date()
    diff=(dt-today).days
    label='Tomorrow' if diff==1 else dt.strftime('%A')
    h=day['hourly'][4]
    desc=h['weatherDesc'][0]['value'].strip()
    icon=weather_icon(desc, False)
    print(f\"{label:<10} {day['mintempC']:>2}–{day['maxtempC']:>2}°C  {icon}  rain {h['chanceofrain']:>3}%  {desc}\")
" 2>/dev/null)
echo "<tool>$tooltip</tool>"
