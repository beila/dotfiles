#!/bin/bash
# Change volume and show OSD via dzen2.
# Uses a FIFO so rapid key presses update text without flicker.
# Usage: volume-osd up|down|toggle
FIFO="/tmp/volume-osd-fifo"
LOCKFILE="/tmp/volume-osd-lock"
OSD_FG="#58AB41" # LEGO Bright Green

audio_command() {
    timeout --kill-after=1 2 "$@"
}

start_dzen() {
    rm -f "$FIFO"
    mkfifo "$FIFO"
    scale=$(xrdb -query 2>/dev/null | awk '/Xft.dpi/{printf "%d", $2/96}')
    : "${scale:=1}"
    (tail -f "$FIFO" | dzen2 -p -x $((100*scale)) -y $((100*scale)) -w $((1240*scale)) -h $((100*scale)) \
        -fn "JetBrainsMono Nerd Font:size=36:style=Bold" \
        -bg "#0d0d1a" -fg "$OSD_FG" -title-name "vol-osd") &
    osd-click-through "vol-osd" || true
}

case "$1" in
    up)     audio_command amixer -q set Master 5%+ || exit 1 ;;
    down)   audio_command amixer -q set Master 5%- || exit 1 ;;
    toggle) audio_command amixer -q set Master toggle || exit 1 ;;
esac

mixer=$(audio_command amixer get Master) || exit 1
vol=$(rg -o '\d+%' <<<"$mixer" | head -1)
mute=$(rg -o '\[o[fn]+\]' <<<"$mixer" | head -1)
pct=${vol%\%}
[[ $pct =~ ^[0-9]+$ ]] || exit 1

if [ "$mute" = "[off]" ]; then
    text="  󰝟  MUTED"
else
    bar=""
    filled=$((pct / 5))
    for ((i=0; i<20; i++)); do
        if [ $i -lt $filled ]; then bar+="━"; else bar+="┄"; fi
    done
    text="  󰕾  $bar  $vol"
fi

[ -p "$FIFO" ] || start_dzen
echo "$text" > "$FIFO"

echo $$ > "$LOCKFILE"
(sleep 2; [ "$(cat "$LOCKFILE" 2>/dev/null)" = "$$" ] && pkill -f "dzen2.*vol-osd" && rm -f "$FIFO") &
