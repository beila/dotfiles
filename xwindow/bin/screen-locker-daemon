#!/usr/bin/env bash
set -u

xset_cmd=${SCREEN_LOCKER_XSET:-xset}
xss_lock_cmd=${SCREEN_LOCKER_XSS_LOCK:-xss-lock}
locker_cmd=${SCREEN_LOCKER_COMMAND:-$HOME/.dotfiles/xwindow/bin/xsecurelock-run}
loginctl_cmd=${SCREEN_LOCKER_LOGINCTL:-/usr/bin/loginctl}
lock_file=${SCREEN_LOCKER_LOCK_FILE:-${XDG_RUNTIME_DIR:-/tmp}/screen-locker-daemon.lock}
timeout=${SCREEN_LOCKER_TIMEOUT:-900}
cycle=${SCREEN_LOCKER_CYCLE:-5}
session_id=${SCREEN_LOCKER_SESSION_ID:-${XDG_SESSION_ID:-}}

exec 9>"$lock_file"
flock -n 9 || exit 0

if [[ -z $session_id ]]; then
	session_id=$("$loginctl_cmd" show-user "$UID" --property=Display --value)
fi

"$xset_cmd" s "$timeout" "$cycle" || exit 1

while true; do
	if [[ -n $session_id ]]; then
		"$xss_lock_cmd" -s "$session_id" -l -- "$locker_cmd"
	else
		"$xss_lock_cmd" -l -- "$locker_cmd"
	fi
	status=$?
	[[ ${SCREEN_LOCKER_ONCE:-0} == 1 ]] && exit "$status"
	sleep 1
done
