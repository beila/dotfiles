#!/bin/bash
# Cycle audio output (sink) with OSD.
# First press: show current device. Subsequent presses while visible: cycle to next.
FIFO="/tmp/audio-out-osd-fifo"
LOCKFILE="/tmp/audio-out-osd-lock"
STATEFILE="/tmp/audio-out-osd-showing"
OSD_FG="#069D9F" # LEGO Bright Bluish Green

audio_command() {
    timeout --kill-after=1 2 "$@"
}

start_dzen() {
    rm -f "$FIFO"
    mkfifo "$FIFO"
    scale=$(xrdb -query 2>/dev/null | awk '/Xft.dpi/{printf "%d", $2/96}')
    : "${scale:=1}"
    (tail -f "$FIFO" | dzen2 -p -x $((100*scale)) -y $((210*scale)) -w $((1240*scale)) -h $((100*scale)) \
        -fn "JetBrainsMono Nerd Font:size=36:style=Bold" \
        -bg "#0d0d1a" -fg "$OSD_FG" -title-name "audio-out-osd") &
    osd-click-through "audio-out-osd" || true
}

# If popup is already showing, cycle to next
status=$(audio_command wpctl status) || exit 1
if [ -f "$STATEFILE" ] && [ -p "$FIFO" ]; then
    sinks=$(printf '%s\n' "$status" | sed -n '/Sinks:/,/Sink endpoints/p' | rg '│.*[0-9]\.')
    mapfile -t ids < <(echo "$sinks" | awk '{for(i=1;i<=NF;i++) if($i ~ /^[0-9]+\.$/) print substr($i,1,length($i)-1)}')
    current=$(echo "$sinks" | rg '\*' | awk '{for(i=1;i<=NF;i++) if($i ~ /^[0-9]+\.$/) print substr($i,1,length($i)-1)}')

    total=${#ids[@]}
    for i in "${!ids[@]}"; do
        if [ "${ids[$i]}" = "$current" ]; then
            for ((j=1; j<total; j++)); do
                next_i=$(( (i + j) % total ))
                audio_command wpctl set-default "${ids[$next_i]}" 2>/dev/null || continue
                sleep 0.2
                status=$(audio_command wpctl status) || exit 1
                new=$(printf '%s\n' "$status" | sed -n '/Sinks:/,/Sink endpoints/p' | rg '\*' | awk '{for(k=1;k<=NF;k++) if($k ~ /^[0-9]+\.$/) print substr($k,1,length($k)-1)}')
                [ "$new" != "$current" ] && break
            done
            break
        fi
    done
fi

name=$(printf '%s\n' "$status" | sed -n '/Sinks:/,/Sink endpoints/p' | rg '\*' | sed 's/.*\*\s*[0-9]*\.\s*//' | sed 's/\[vol:.*//' | xargs)
[[ -n $name ]] || exit 1
[ -p "$FIFO" ] || start_dzen
touch "$STATEFILE"
echo "  󰓃  $name" > "$FIFO"

echo $$ > "$LOCKFILE"
(sleep 3; [ "$(cat "$LOCKFILE" 2>/dev/null)" = "$$" ] && pkill -f "dzen2.*audio-out-osd" && rm -f "$FIFO" "$STATEFILE") &
