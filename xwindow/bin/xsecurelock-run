#!/usr/bin/env bash
set -u

property=_XMONAD_SCREEN_LOCKED
xprop_cmd=${XSECURELOCK_RUN_XPROP:-xprop}
locker_cmd=${XSECURELOCK_RUN_COMMAND:-xsecurelock}
installed_locker=$HOME/.local/libexec/xsecurelock/package/bin/xsecurelock
if [[ -z ${XSECURELOCK_RUN_COMMAND:-} && -x $installed_locker ]]; then
	locker_cmd=$installed_locker
fi
wallpaper_cmd=${XSECURELOCK_RUN_WALLPAPER:-$HOME/.dotfiles/xwindow/bin/lockscreen-wallpaper}
authproto=${XSECURELOCK_RUN_AUTHPROTO:-$HOME/.local/libexec/xsecurelock/authproto_pam-host}
lock_file=${XSECURELOCK_RUN_LOCK_FILE:-${XDG_RUNTIME_DIR:-/tmp}/xsecurelock-run.lock}

publish_state() {
	"$xprop_cmd" -root -f "$property" 32c -set "$property" "$1"
}

if [[ ${1:-} == --notify ]]; then
	publish_state 1
	exit
fi
if (($#)); then
	printf 'usage: %s\n' "${0##*/}" >&2
	exit 2
fi

exec 9>"$lock_file"
flock -n 9 || exit 0

username=$(/usr/bin/id -un) || {
	printf 'xsecurelock-run: cannot resolve the login username\n' >&2
	exit 1
}
if [[ ! -x $authproto ]]; then
	printf 'xsecurelock-run: authentication helper is unavailable: %s\n' "$authproto" >&2
	exit 1
fi

trap 'publish_state 0' EXIT
trap 'exit 1' HUP INT TERM

export XSECURELOCK_USERNAME="$username"
export XSECURELOCK_AUTHPROTO="$authproto"
export XSECURELOCK_SAVER=saver_mpv
export XSECURELOCK_LIST_VIDEOS_COMMAND="$wallpaper_cmd"
# Limit the wallpaper lookup so a stalled settings service cannot delay locking.
auth_background_image=$(timeout 1 "$wallpaper_cmd") || auth_background_image=
export XSECURELOCK_AUTH_BACKGROUND_IMAGE="$auth_background_image"
export XSECURELOCK_AUTH_BACKGROUND_OPACITY=50
export XSECURELOCK_AUTH_X_PERCENT=50
export XSECURELOCK_AUTH_Y_PERCENT=80
export XSECURELOCK_IMAGE_DURATION_SECONDS=86400
# Show the full image. With --panscan=1.0, mpv filled the screen and cut the parts of
# the image outside it: a portrait photo on a landscape screen lost most of its height.
export XSECURELOCK_VIDEOS_FLAGS="--panscan=0 --keepaspect=yes"
export XSECURELOCK_SAVER_DELAY_MS=250

"$locker_cmd" -- "$0" --notify
