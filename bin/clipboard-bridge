#!/usr/bin/env python3
"""Share clipboard text and images with local and remote terminal applications."""

import subprocess
import sys

from clipboard_bridge import main

if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, RuntimeError, subprocess.SubprocessError) as error:
        print(f"clipboard-bridge: {error}", file=sys.stderr)
        sys.exit(1)
