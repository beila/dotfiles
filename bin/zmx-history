#!/usr/bin/env bash
# Persist the latest rendered scrollback for every live zmx session.

set -uo pipefail
umask 0077

zmx_bin="${ZMX_BIN:-zmx}"
history_dir="${ZMX_HISTORY_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/zmx/history}"
runtime_dir="${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/zmx-history-$UID"
max_bytes="${ZMX_HISTORY_MAX_BYTES:-5242880}"
scan_seconds="${ZMX_HISTORY_SCAN_SECONDS:-5}"

usage() {
    cat >&2 <<'EOF'
Usage: zmx-history [serve]
       zmx-history snapshot SESSION [CWD]
       zmx-history path SESSION
       zmx-history cwd SESSION
       zmx-history has SESSION
       zmx-history show SESSION
       zmx-history remove SESSION
       zmx-history list [--with-cwd]
EOF
    exit 2
}

case "$max_bytes" in
    ''|*[!0-9]*|0) echo "zmx-history: ZMX_HISTORY_MAX_BYTES must be a positive integer" >&2; exit 2 ;;
esac

history_path() {
    local session=$1 safe hash
    safe=$(printf '%s' "$session" | sed -E 's/[^[:alnum:]_.-]+/_/g')
    [[ -n "$safe" && "$safe" != "." && "$safe" != ".." ]] || safe=session
    hash=$(printf '%s' "$session" | sha256sum)
    printf '%s/%s-%s.history\n' "$history_dir" "$safe" "${hash:0:12}"
}

cwd_path() {
    local target
    target=$(history_path "$1")
    printf '%s\n' "${target%.history}.cwd"
}

write_name_file() {
    local session=$1 target=$2 name_path name_tmp
    name_path="${target%.history}.name"
    name_tmp="$name_path.tmp.$$"
    if printf '%s\n' "$session" > "$name_tmp"; then
        chmod 0600 "$name_tmp"
        sync -d "$name_tmp" 2>/dev/null || true
        mv -f "$name_tmp" "$name_path"
    else
        rm -f "$name_tmp"
    fi
}

write_cwd_file() {
    local session=$1 cwd=$2 target existing cwd_tmp
    [[ "$cwd" == /* && "$cwd" != *$'\n'* ]] || return 0

    target=$(cwd_path "$session")
    if [[ -f "$target" ]]; then
        existing=""
        IFS= read -r existing < "$target" || true
        [[ "$existing" == "$cwd" ]] && return 0
    fi

    cwd_tmp="$target.tmp.$$"
    if printf '%s\n' "$cwd" > "$cwd_tmp"; then
        chmod 0600 "$cwd_tmp"
        sync -d "$cwd_tmp" 2>/dev/null || true
        mv -f "$cwd_tmp" "$target"
        sync "$history_dir" 2>/dev/null || true
    else
        rm -f "$cwd_tmp"
    fi
}

prepare_dirs() {
    install -d -m 0700 "$history_dir" "$runtime_dir"
}

live_session_cwd() {
    local session=$1 pid cwd
    pid=$("$zmx_bin" list 2>/dev/null | awk -F'\t' -v wanted="$session" '
        {
            for (i=1; i<=NF; i++) {
                sub(/^[[:space:]]+/, "", $i)
                sub(/^[^=]*=/, "", $i)
            }
            if ($1 == wanted) {
                print $2
                exit
            }
        }
    ')
    [[ "$pid" =~ ^[0-9]+$ ]] || return 1
    cwd=$(readlink "/proc/$pid/cwd" 2>/dev/null) || return 1
    [[ "$cwd" == /* ]] || return 1
    printf '%s\n' "$cwd"
}

snapshot_session() (
    local session=$1 supplied_cwd=${2:-} cwd target runtime_tmp persist_tmp
    exec 8>"$history_dir/.snapshot.lock"
    flock 8 || return

    target=$(history_path "$session")
    runtime_tmp=$(mktemp "$runtime_dir/snapshot.XXXXXX") || return
    cwd="$supplied_cwd"
    [[ -n "$cwd" ]] || cwd=$(live_session_cwd "$session" 2>/dev/null || true)

    if ! "$zmx_bin" history "$session" 2>/dev/null \
        | tail -c "$max_bytes" > "$runtime_tmp"; then
        rm -f "$runtime_tmp"
        return
    fi

    if [[ -f "$target" ]] && cmp -s "$runtime_tmp" "$target"; then
        [[ -n "$cwd" ]] && write_cwd_file "$session" "$cwd"
        rm -f "$runtime_tmp"
        return
    fi

    persist_tmp="$target.tmp.$$"
    if cp "$runtime_tmp" "$persist_tmp"; then
        chmod 0600 "$persist_tmp"
        sync -d "$persist_tmp" 2>/dev/null || true
        mv -f "$persist_tmp" "$target"
        write_name_file "$session" "$target"
        [[ -n "$cwd" ]] && write_cwd_file "$session" "$cwd"
        sync "$history_dir" 2>/dev/null || true
    else
        rm -f "$persist_tmp"
    fi
    rm -f "$runtime_tmp"
)

remove_session() (
    local session=$1 target name_path saved_cwd_path
    exec 8>"$history_dir/.snapshot.lock"
    flock 8 || return

    target=$(history_path "$session")
    name_path="${target%.history}.name"
    saved_cwd_path="${target%.history}.cwd"
    rm -f -- "$name_path" "$saved_cwd_path" "$target"
    sync "$history_dir" 2>/dev/null || true
)

list_sessions() {
    if [[ -n "${ZMX_HISTORY_SESSIONS_FILE:-}" ]]; then
        cat "$ZMX_HISTORY_SESSIONS_FILE" 2>/dev/null || true
        return
    fi

    local socket
    local -a sockets=()
    shopt -s nullglob
    sockets=("$zmx_socket_dir"/*)
    shopt -u nullglob
    for socket in "${sockets[@]}"; do
        [[ -S "$socket" ]] || continue
        basename -- "$socket"
    done
}

log_signature() {
    local session=$1
    if [[ -n "$zmx_log_dir" && -f "$zmx_log_dir/$session.log" ]]; then
        stat -c '%Y:%s' "$zmx_log_dir/$session.log" 2>/dev/null || printf 'missing\n'
    else
        printf 'missing\n'
    fi
}

serve() {
    prepare_dirs

    exec 9>"$history_dir/.lock"
    flock -n 9 || exit 0

    local zmx_info
    zmx_info=$("$zmx_bin" version 2>/dev/null || true)
    zmx_log_dir=$(printf '%s\n' "$zmx_info" | awk '$1 == "log_dir" { print $2; exit }')
    zmx_socket_dir=$(printf '%s\n' "$zmx_info" | awk '$1 == "socket_dir" { print $2; exit }')
    [[ -n "$zmx_socket_dir" || -n "${ZMX_HISTORY_SESSIONS_FILE:-}" ]] || {
        echo "zmx-history: zmx did not report a socket directory" >&2
        exit 1
    }

    local session signature
    local -a sessions=()
    declare -A signatures=()
    declare -A active=()

    mapfile -t sessions < <(list_sessions)
    for session in "${sessions[@]}"; do
        [[ -n "$session" ]] || continue
        snapshot_session "$session"
        signatures["$session"]=$(log_signature "$session")
    done

    while sleep "$scan_seconds"; do
        for session in "${!signatures[@]}"; do
            signature=$(log_signature "$session")
            if [[ "$signature" == "missing" || "$signature" != "${signatures[$session]}" ]]; then
                snapshot_session "$session"
                signatures["$session"]=$(log_signature "$session")
            fi
        done

        mapfile -t sessions < <(list_sessions)
        active=()
        for session in "${sessions[@]}"; do
            [[ -n "$session" ]] || continue
            active["$session"]=1
            if [[ -z "${signatures[$session]:-}" ]]; then
                snapshot_session "$session"
                signatures["$session"]=$(log_signature "$session")
            fi
        done

        for session in "${!signatures[@]}"; do
            [[ -n "${active[$session]:-}" ]] || unset 'signatures[$session]'
        done
    done
}

command="${1:-serve}"
case "$command" in
    serve)
        [[ $# -le 1 ]] || usage
        serve
        ;;
    snapshot)
        [[ $# -ge 2 && $# -le 3 ]] || usage
        prepare_dirs
        snapshot_session "$2" "${3:-}"
        ;;
    path)
        [[ $# -eq 2 ]] || usage
        history_path "$2"
        ;;
    cwd)
        [[ $# -eq 2 ]] || usage
        target=$(cwd_path "$2")
        [[ -s "$target" ]] || exit 1
        saved_cwd=""
        IFS= read -r saved_cwd < "$target" || exit 1
        [[ "$saved_cwd" == /* ]] || exit 1
        printf '%s\n' "$saved_cwd"
        ;;
    has)
        [[ $# -eq 2 ]] || usage
        [[ -s "$(history_path "$2")" ]]
        ;;
    show)
        [[ $# -eq 2 ]] || usage
        target=$(history_path "$2")
        [[ -s "$target" ]] || exit 1
        tail -n 500 "$target"
        ;;
    remove)
        [[ $# -eq 2 ]] || usage
        prepare_dirs
        remove_session "$2"
        ;;
    list)
        [[ $# -eq 1 || ($# -eq 2 && "$2" == "--with-cwd") ]] || usage
        shopt -s nullglob
        names=("$history_dir"/*.name)
        for name_file in "${names[@]}"; do
            session=""
            IFS= read -r session < "$name_file" || true
            [[ -n "${session:-}" ]] || continue
            if [[ "${2:-}" == "--with-cwd" ]]; then
                saved_cwd=""
                saved_cwd_file="${name_file%.name}.cwd"
                if [[ -s "$saved_cwd_file" ]]; then
                    IFS= read -r saved_cwd < "$saved_cwd_file" || saved_cwd=""
                fi
                printf '%s\t%s\n' "$session" "${saved_cwd/#$HOME/'~'}"
            else
                printf '%s\n' "$session"
            fi
        done | sort -u
        ;;
    *)
        usage
        ;;
esac
