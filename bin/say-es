#!/usr/bin/env bash
# Spanish text-to-speech via edge-tts (requires internet)
# Usage: say-es [--voice N] [--speed PERCENT] "texto en español"
#
# Voice is chosen from VOICE_POOL by the shared caller-key mapping in
# say-voice.sh (the single place hashing lives). $EDGE_TTS_VOICE overrides
# automatic selection.
source "$(dirname "$0")/say-voice.sh"
VOICE_POOL=(
    es-ES-AlvaroNeural
    es-ES-ElviraNeural
    es-ES-XimenaNeural
    es-MX-DaliaNeural
    es-MX-JorgeNeural
    es-US-AlonsoNeural
    es-US-PalomaNeural
)

list_voices() {
    local i
    for i in "${!VOICE_POOL[@]}"; do
        printf '%d\t%s\n' "$((i + 1))" "${VOICE_POOL[$i]}"
    done
}

usage() {
    cat <<'EOF_USAGE'
Usage: say-es [OPTIONS] [TEXT...]
       printf '%s\n' TEXT | say-es [OPTIONS]

Options:
  -v, --voice N       Select a numbered voice instead of automatic selection
  -s, --speed PERCENT Speech-speed change, for example 25, +25%, or -10%
  -l, --list-voices   List numbered voices
  -h, --help          Show this help

Voices:
EOF_USAGE
    list_voices
}

if ! say_parse_options "$@"; then
    usage >&2
    exit 2
fi
if [ "$SAY_CLI_SHOW_HELP" = 1 ]; then
    usage
    exit 0
fi
if [ "$SAY_CLI_LIST_VOICES" = 1 ]; then
    list_voices
    exit 0
fi

if [ -n "$SAY_CLI_VOICE_NUMBER" ]; then
    index="$(say_pick_index "${#VOICE_POOL[@]}" "$SAY_CLI_VOICE_NUMBER")" || exit
    VOICE="${VOICE_POOL[$index]}"
else
    VOICE="${EDGE_TTS_VOICE:-${VOICE_POOL[$(say_pick_index "${#VOICE_POOL[@]}")]}}"
fi
RATE="$(say_normalize_speed "${SAY_CLI_SPEED:-${EDGE_TTS_RATE:-+50%}}")" || exit

if [ "${#SAY_CLI_TEXT_ARGS[@]}" -gt 0 ]; then
    TEXT="${SAY_CLI_TEXT_ARGS[*]}"
else
    TEXT="$(cat)"
fi
[ -z "$TEXT" ] && exit 0
TMP="$(mktemp /tmp/say-es-XXXXXX.mp3)"
trap 'rm -f "$TMP"' EXIT
uv run --quiet --with edge-tts -- edge-tts --voice "$VOICE" --rate="$RATE" --text "$TEXT" --write-media "$TMP" 2>/dev/null \
  && ffmpeg -v quiet -i "$TMP" -f wav -acodec pcm_s16le -ar 24000 -ac 1 pipe:1 2>/dev/null \
  | aplay -q 2>/dev/null
