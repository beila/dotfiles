#!/usr/bin/env bash
# zmx-select — interactive fzf picker for zmx sessions
#
# Lists the preset sessions from bin/zmx-sessions plus any other running
# session, with live scrollback preview. Actions:
#   Enter    — attach to the highlighted session, starting it if it isn't
#              running (or create one named after the typed query if no match)
#   Ctrl-N   — create a new session with the typed query; auto-suffixes -2, -3, ...
#              if that name is already in use
#   Ctrl-C   — exit without attaching
#
# Presets are listed in file order so the picker layout stays put as sessions
# start and stop. Non-preset running sessions follow, so ad-hoc ones stay
# reachable. With neither presets nor running sessions the picker is skipped and
# a default session is attached directly: first CLI arg, or
# $ZMX_DEFAULT_SESSION, or `main`. The first arg also seeds the fzf query.
#
# Adapted from https://github.com/neurosnap/zmx (session picker section).

set -euo pipefail

initial_query="${1:-}"
default_session="${ZMX_DEFAULT_SESSION:-main}"
sessions_file="${ZMX_SESSIONS_FILE:-$(dirname "$(readlink -f "$0")")/zmx-sessions}"

# name -> "pid<TAB>clients<TAB>start_dir" for every running session.
# zmx list emits each field as "key=value" separated by tabs, with leading
# whitespace.
declare -A running=()
while IFS=$'\t' read -r name pid clients dir; do
    [[ -n "$name" ]] && running["$name"]="$pid	$clients	$dir"
done < <(zmx list 2>/dev/null | awk -F'\t' '
    {
        for (i=1; i<=NF; i++) {
            sub(/^[[:space:]]+/, "", $i)
            sub(/^[^=]*=/, "", $i)
        }
        if ($1 != "") print $1 "\t" $2 "\t" $3 "\t" $5
    }
')

row() {  # name -> display line; stopped sessions get placeholders
    local name=$1 pid clients dir cwd
    if [[ -n "${running[$name]:-}" ]]; then
        IFS=$'\t' read -r pid clients dir <<<"${running[$name]}"
        # zmx list reports start_dir, which never moves. The shell's live cwd
        # is what you actually want to recognise a session by, so read it from
        # /proc and keep start_dir as the fallback (foreign pid, race on exit).
        cwd=$(readlink "/proc/$pid/cwd" 2>/dev/null) || cwd=""
        [[ -n "$cwd" ]] || cwd="$dir"
        # Quote the tilde: bash tilde-expands the replacement, so a bare ~ would
        # substitute $HOME back in and the shortening would silently no-op.
        printf '%-14s  pid:%-8s  clients:%-2s  %s\n' "$name" "$pid" "$clients" "${cwd/#$HOME/'~'}"
    else
        printf '%-14s  %-13s  %-12s\n' "$name" "-" "not started"
    fi
}

# Presets first (stable order), then running sessions that aren't presets.
declare -A is_preset=()
display=""
if [[ -r "$sessions_file" ]]; then
    while read -r name _; do
        [[ -z "$name" || "$name" == \#* ]] && continue
        is_preset["$name"]=1
        display+=$(row "$name")$'\n'
    done < "$sessions_file"
fi
for name in "${!running[@]}"; do
    [[ -n "${is_preset[$name]:-}" ]] || display+=$(row "$name")$'\n'
done

# Nothing to show at all: create the default session directly.
if [[ -z "${display//[$'\n']/}" ]]; then
    exec zmx attach "${initial_query:-$default_session}"
fi

# Preview: backlog then live output. `zmx tail` alone prints only NEW output, so
# the history prefix is what makes a quiet session readable. Stopped sessions
# have no history to show.
preview_cmd='
if zmx list --short 2>/dev/null | grep -Fxq -- "$1"; then
    zmx history "$1" 2>/dev/null | tail -500
    exec zmx tail "$1" 2>/dev/null
else
    printf "%s is not running — Enter starts it.\n" "$1"
fi'

rc=0
output=$(printf '%s' "$display" | fzf \
    --print-query \
    --expect=ctrl-n \
    --height=80% \
    --reverse \
    --prompt="zmx> " \
    --header="Enter: attach (starts if stopped) | Ctrl-N: new session | Ctrl-C: exit" \
    --preview="sh -c '$preview_cmd' _ {1}" \
    --preview-window=right:60%:follow \
    --query="$initial_query") || rc=$?

query=$(printf '%s\n' "$output" | sed -n '1p')
key=$(printf '%s\n' "$output"   | sed -n '2p')
selected=$(printf '%s\n' "$output" | sed -n '3p')

if [[ "$key" == "ctrl-n" && -n "$query" ]]; then
    # Force a NEW session. If a session with the requested name already
    # exists, append -2, -3, ... until we find a free name. This matches
    # the mental model of Ctrl-N = "create", not "reuse".
    base="$query"
    session="$base"
    n=2
    while zmx list --short 2>/dev/null | grep -Fxq -- "$session"; do
        session="$base-$n"
        n=$((n + 1))
    done
elif [[ $rc -eq 0 && -n "$selected" ]]; then
    session=$(printf '%s' "$selected" | awk '{print $1}')
elif [[ -n "$query" ]]; then
    session="$query"
else
    exit 130
fi

# `attach` creates the session when it doesn't exist, so preset rows and typed
# names need no separate create step.
exec zmx attach "$session"
