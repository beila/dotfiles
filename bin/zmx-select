#!/usr/bin/env bash
# zmx-select — interactive fzf picker for zmx sessions
#
# Lists the preset sessions from bin/zmx-sessions plus any other running
# session, with live scrollback preview. Actions:
#   Enter    — attach to the highlighted session, starting it if it isn't
#              running (or create one named after the typed query if no match)
#   Ctrl-N   — create a new session with the typed query; auto-suffixes -2, -3, ...
#              if that name is already in use
#   Ctrl-C   — exit without attaching
#
# Detaching (ctrl-\) or exiting the session's shell returns to the picker with
# the cursor back on the session you just left; Ctrl-C / Esc in the picker is
# the way out.
#
# Ad-hoc running sessions are listed first, then the presets in file order so
# that part of the layout stays put as sessions start and stop. With neither presets nor running sessions the picker is skipped and
# a default session is attached directly: first CLI arg, or
# $ZMX_DEFAULT_SESSION, or `main`. The first arg also seeds the fzf query.
#
# Adapted from https://github.com/neurosnap/zmx (session picker section).

set -uo pipefail

initial_query="${1:-}"
default_session="${ZMX_DEFAULT_SESSION:-main}"
script_dir=$(dirname "$(readlink -f "$0")")
sessions_file="${ZMX_SESSIONS_FILE:-$script_dir/zmx-sessions}"
export ZMX_HISTORY_HELPER="$script_dir/zmx-history"

# zmx spawns a login $SHELL, which on this account is bash (LDAP, no chsh), so a
# fresh session would come up in bash. Ask for the same shell ghostty launches
# (`command = zsh -l`) instead. Only applies at creation — re-attaching an
# existing session keeps whatever process it already runs.
session_shell=()
command -v zsh >/dev/null 2>&1 && session_shell=(zsh -l)

# Preview: backlog then live output. `zmx tail` alone prints only NEW output, so
# the history prefix is what makes a quiet session readable. Stopped sessions
# have no history to show.
preview_cmd='
if zmx list --short 2>/dev/null | grep -Fxq -- "$1"; then
    zmx history "$1" 2>/dev/null | tail -500
    exec zmx tail "$1" 2>/dev/null
elif [ -x "$ZMX_HISTORY_HELPER" ] && "$ZMX_HISTORY_HELPER" has "$1"; then
    printf "[stopped -- last persisted snapshot]\n\n"
    exec "$ZMX_HISTORY_HELPER" show "$1"
else
    printf "%s is not running — Enter starts it.\n" "$1"
fi'

# name -> "pid<TAB>clients" for every running session. zmx list emits each field
# as "key=value" separated by tabs, with leading whitespace.
declare -A running=()
declare -A saved=()
load_running() {
    running=()
    local name pid clients
    while IFS=$'\t' read -r name pid clients; do
        [[ -n "$name" ]] && running["$name"]="$pid	$clients"
    done < <(zmx list 2>/dev/null | awk -F'\t' '
        {
            for (i=1; i<=NF; i++) {
                sub(/^[[:space:]]+/, "", $i)
                sub(/^[^=]*=/, "", $i)
            }
            if ($1 != "") print $1 "\t" $2 "\t" $3
        }
    ')
}

load_saved() {
    saved=()
    [[ -x "$ZMX_HISTORY_HELPER" ]] || return
    local name
    while IFS= read -r name; do
        [[ -n "$name" ]] && saved["$name"]=1
    done < <("$ZMX_HISTORY_HELPER" list 2>/dev/null)
}

# name -> the session shell's live cwd, $HOME-shortened, empty if unknown.
# zmx list reports start_dir, which never moves, so read /proc instead. Blank
# when /proc can't answer — a stale directory would be worse than none. Quote
# the tilde: bash tilde-expands the replacement, so a bare ~ substitutes $HOME
# back in and no-ops.
session_cwd() {
    local name=$1 pid cwd
    [[ -n "${running[$name]:-}" ]] || return 0
    IFS=$'\t' read -r pid _ <<<"${running[$name]}"
    cwd=$(readlink "/proc/$pid/cwd" 2>/dev/null) || return 0
    printf '%s' "${cwd/#$HOME/'~'}"
}

row() {  # name -> display line; stopped sessions are just the name
    local name=$1 pid clients
    if [[ -n "${running[$name]:-}" ]]; then
        IFS=$'\t' read -r pid clients <<<"${running[$name]}"
        # clients > 0 means it's open in another window; worth knowing before
        # you attach a second client to the same session.
        printf '%-14s  %s%s\n' "$name" "$(session_cwd "$name")" \
            "$([[ ${clients:-0} -gt 0 ]] && printf '  (attached)')"
    elif [[ -n "${saved[$name]:-}" ]]; then
        printf '%-14s  (saved)\n' "$name"
    else
        printf '%s\n' "$name"
    fi
}

# Ad-hoc running sessions first (they're the transient ones you came back for),
# then the presets in file order — that part stays put as sessions start and
# stop. Sets $display and $order (parallel array of names, for cursor
# positioning).
build_display() {
    local -A is_preset=()
    local name
    display=""
    order=()

    if [[ -r "$sessions_file" ]]; then
        while read -r name _; do
            [[ -z "$name" || "$name" == \#* ]] && continue
            is_preset["$name"]=1
        done < "$sessions_file"
    fi

    # Sorted, because associative-array key order is a hash order — without this
    # the top of the list would reshuffle between invocations.
    local -A is_adhoc=()
    for name in "${!running[@]}"; do
        [[ -n "${is_preset[$name]:-}" ]] || is_adhoc["$name"]=1
    done
    for name in "${!saved[@]}"; do
        [[ -n "${is_preset[$name]:-}" ]] || is_adhoc["$name"]=1
    done
    if ((${#is_adhoc[@]})); then
        while IFS= read -r name; do
            [[ -n "$name" ]] || continue
            display+=$(row "$name")$'\n'
            order+=("$name")
        done < <(printf '%s\n' "${!is_adhoc[@]}" | sort)
    fi

    if [[ -r "$sessions_file" ]]; then
        while read -r name _; do
            [[ -z "$name" || "$name" == \#* ]] && continue
            display+=$(row "$name")$'\n'
            order+=("$name")
        done < "$sessions_file"
    fi
}

last_session=""
query="$initial_query"

while true; do
    load_running
    build_display

    # While the picker is up the window belongs to no session; say so, otherwise
    # the tag keeps advertising the session you just left.
    printf '\033]1;zmx\007\033]2;zmx\007' > /dev/tty 2>/dev/null || true

    # Nothing to show at all: create the default session directly.
    if [[ -z "${display//[$'\n']/}" ]]; then
        exec zmx attach "${initial_query:-$default_session}" "${session_shell[@]}"
    fi

    # Put the cursor back on the session we just came out of. pos() indexes the
    # list from the top, matching the order we emitted (with --reverse).
    start_bind=()
    if [[ -n "$last_session" ]]; then
        for i in "${!order[@]}"; do
            if [[ "${order[$i]}" == "$last_session" ]]; then
                start_bind=(--bind "start:pos($((i + 1)))")
                break
            fi
        done
    fi

    rc=0
    output=$(printf '%s' "$display" | fzf \
        --print-query \
        --expect=ctrl-n \
        --height=80% \
        --reverse \
        --prompt="zmx> " \
        --header="Enter: attach (starts if stopped) | Ctrl-N: new session | Ctrl-C: exit" \
        --preview="sh -c '$preview_cmd' _ {1}" \
        --preview-window=right:60%:follow \
        "${start_bind[@]}" \
        --query="$query") || rc=$?

    query=$(printf '%s\n' "$output" | sed -n '1p')
    key=$(printf '%s\n' "$output"   | sed -n '2p')
    selected=$(printf '%s\n' "$output" | sed -n '3p')

    if [[ "$key" == "ctrl-n" && -n "$query" ]]; then
        # Force a NEW session. If a session with the requested name already
        # exists, append -2, -3, ... until we find a free name. This matches
        # the mental model of Ctrl-N = "create", not "reuse".
        base="$query"
        session="$base"
        n=2
        while zmx list --short 2>/dev/null | grep -Fxq -- "$session"; do
            session="$base-$n"
            n=$((n + 1))
        done
    elif [[ $rc -eq 0 && -n "$selected" ]]; then
        session=$(printf '%s' "$selected" | awk '{print $1}')
    elif [[ -n "$query" ]]; then
        session="$query"
    else
        exit 130
    fi

    # Name the window before handing it over. The session's shell only re-emits
    # its own OSC title (zsh/terminal.zsh) at its next prompt, so attaching to
    # an already-running session would otherwise leave the window — and the
    # xmonad corner tag reading it — showing whatever was there before. Written
    # to /dev/tty so it can never leak into a caller's pipeline.
    tag="[$session]"
    cwd=$(session_cwd "$session")
    [[ -n "$cwd" ]] && tag="$tag $cwd"
    printf '\033]1;%s\007\033]2;%s\007' "$tag" "$tag" > /dev/tty 2>/dev/null || true

    # `attach` creates the session when it doesn't exist, so preset rows and
    # typed names need no separate create step. Not exec'd: when the client
    # detaches (ctrl-\) or the shell exits we come back around to the picker.
    zmx attach "$session" "${session_shell[@]}" || true
    last_session="$session"
    query=""
done
