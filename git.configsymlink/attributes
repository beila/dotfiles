artworks.toml diff=artworkstoml

* text=auto eol=lf
*.{cmd,[cC][mM][dD]} text eol=crlf
*.{bat,[bB][aA][tT]} text eol=crlf

# https://mergiraf.org/usage.html#registration-as-a-git-merge-driver:~:text=(~/.config/git/attributes%20by%20default):-,*%20merge=mergiraf,-If%20you%20would
* merge=mergiraf

# Lock files: always prefer our side on merge — never auto-merge upstream edits
# into a lock file. After merging, re-run the package manager (npm install /
# cargo update --workspace / nix flake update / etc.) to regenerate it against
# the merged source. The `ours` driver is registered in git/gitconfig.symlink.
*.lock              merge=ours
package-lock.json   merge=ours
pnpm-lock.yaml      merge=ours
go.sum              merge=ours

# script/bin/home-template adds .gitignore entries on each machine. Two machines
# that convert different files in one directory change the same lines. A 3-way
# union keeps the entries of both and still applies a removal from one side.
# mergiraf has no grammar for .gitignore. resolve-by-attrs applies this in sync_repo.
.gitignore          merge=union-dedupe

# Private plugin registry templates change between syncs.
# Keep legacy runtime rules until older checkouts complete migration.
# sync_all loads these rules before it updates private-dotfiles.
claude.symlink/plugins/store/*.json                      merge=ours
claude.symlink/plugins/installed_plugins.json.home-template   merge=ours
claude.symlink/plugins/known_marketplaces.json.home-template  merge=ours
# Preserve the legacy index when migrating an older checkout.
codex.symlink/session_index.jsonl                        merge=union-dedupe
