#!/usr/bin/env bash
# Sync every jj/git repo under $HOME via sync_repo. Triggered by
# sync-repos.timer. sync_repo itself exits cleanly on repos that don't
# have a 'backup' remote, so we can iterate broadly without filtering
# client-side.
#
# Deduplicates by repo root so that submodule-heavy monorepos don't invoke
# sync_repo once per nested '.git' marker. Each repo root is visited once;
# sync_repo handles per-workspace iteration via the jj-workspace-aware code
# inside each run.
#
# sync_repo reports low disk space to this script for one batch notification.
# Its log retains the error for each affected repository.

set -u

# Same log-root override as sync_repo (and inherited by the sync_repo subprocess).
if [ "${SYNC_LOG_ROOT_KEEP:-0}" != "1" ]; then
    unset LOG_ROOT LOG_REL_BASE LOG_NOTIFY_DEDUP_DIR
fi

LOG_TAG=sync_all
DOTFILES_ROOT="${DOTFILES_ROOT:-$HOME/.dotfiles}"
# shellcheck source=/dev/null
source "$DOTFILES_ROOT/script/logger/log.sh"

SYNC="$DOTFILES_ROOT/script/sync_repo"
DB="$HOME/.cache/plocate.db"

# Brazil copy-build packages copy their '.jj' into '<workspace>/build/' but not
# the Git store. jj cannot load the copy, and each run reported REPO-LOAD-FAIL.
# A Brazil workspace root contains 'packageInfo'.
in_brazil_build_output() {
    local rest=$1/ head=
    while [[ $rest == */build/* ]]; do
        head+=${rest%%/build/*}
        [ -f "$head/packageInfo" ] && return 0
        head+=/build
        rest=/${rest#*/build/}
    done
    return 1
}

log INFO "START"

if [ ! -f "$DB" ]; then
    log ERROR "plocate database not found at $DB. Run script/updatedb to build it, or check that the updatedb.timer is active (systemctl --user list-timers)."
    exit 1
fi
if [ ! -x "$SYNC" ]; then
    log ERROR "sync_repo script not executable at $SYNC"
    exit 1
fi

# Build the repo list. Dedup by jj root (falls back to git top-level) so
# monorepos with many submodule markers only get one sync_repo invocation.
# Takes a few extra forks per path but is cheap compared to the actual sync.
declare -A seen
repos=()
while IFS= read -r marker; do
    dir=$(dirname "$marker")
    case "$dir" in
        */.cache/*|*/.cargo/*|*/.local/state/*|*/.local/share/Trash/*|*/.nix-profile/*|*/node_modules/*) continue ;;
    esac
    [ -d "$dir" ] || continue
    in_brazil_build_output "$dir" && continue
    # Canonical root: prefer jj root, fall back to git top-level, else the
    # marker-parent itself. Errors here are fine; we'll still iterate.
    root=$(cd "$dir" 2>/dev/null && { jj --ignore-working-copy root 2>/dev/null || git rev-parse --show-toplevel 2>/dev/null; } || echo "$dir")
    if [ -z "${seen[$root]:-}" ]; then
        seen[$root]=1
        repos+=("$root")
    fi
done < <(
    { plocate --database "$DB" -r '/\.jj$'  2>/dev/null
      plocate --database "$DB" -r '/\.git$' 2>/dev/null
    } | sort -u
)

total=${#repos[@]}
failed=0
processed=0
log INFO "discovered $total repo(s)"

disk_report=$(mktemp "${TMPDIR:-/tmp}/sync_all.disk.XXXXXX") || disk_report=
trap 'log_finalize; if [[ -n $disk_report ]]; then rm -f -- "$disk_report"; fi' EXIT
declare -A skipped=() lowest_free=()
disk_failures=0

for repo in ${repos[@]+"${repos[@]}"}; do
    processed=$((processed+1))
    SYNC_LOW_DISK_REPORT="$disk_report" "$SYNC" "$repo"
    rc=$?
    if [ "$rc" -ne 0 ]; then
        failed=$((failed+1))
        if [[ -s $disk_report ]] && IFS=$'\t' read -r free_mb minimum mount < "$disk_report"; then
            : > "$disk_report"
            ((disk_failures+=1))
            skipped["$mount"]=$(( ${skipped["$mount"]:-0} + 1 ))
            if (( free_mb <= ${lowest_free["$mount"]:-free_mb} )); then
                lowest_free["$mount"]=$free_mb
            fi
            LOG_NOTIFY_MODE=never log WARN "FAILED rc=$rc $repo (LOW-DISK $mount, $free_mb MiB free)"
        else
            log WARN "FAILED rc=$rc $repo"
        fi
    fi
done

if [ "$failed" -gt 0 ]; then
    summary="SUMMARY processed=$processed failed=$failed (per-repo paths logged above as WARN)"
    if (( disk_failures )); then
        disk_key="LOW-DISK $LOG_MACHINE_NAME"
        while IFS= read -r mount; do
            summary+=$'\n'"LOW-DISK $mount: ${lowest_free["$mount"]} MiB free (minimum $minimum MiB), repos skipped=${skipped["$mount"]}"
            disk_key+=$'\n'"$mount"
        done < <(printf '%s\n' "${!skipped[@]}" | LC_ALL=C sort)
        if (( disk_failures == failed )); then
            LOG_NOTIFY_KEY=$disk_key
        fi
    fi
    log ERROR "$summary"
    exit 1
fi
log INFO "SUMMARY processed=$processed failed=0"
