#!/usr/bin/env bash
# generalize-paths — stream filter that replaces this machine's absolute
# home-directory path with the standard placeholder string `$HOME`.
# Standard-input-to-standard-output filter with no tracked-file edits.
#
# Used by `jj fix` (configured in jj.configsymlink/config.toml) to scrub
# committed file content so it's portable across machines with different
# home directories (for example, an LDAP home versus a macOS home).
#
# `$HOME` is deliberately left portable in the working tree. There is no
# reverse bootstrap filter: expanding it globally would also hard-code
# legitimate runtime `$HOME` references in scripts and configuration.
# Consumers that require an absolute path must be generated separately or
# excluded from this jj fix tool.
#
# Mechanism notes:
#   - Input is buffered in a temporary file so `file` can identify binary
#     content. Only ASCII and UTF-8 text are rewritten; everything else is
#     emitted byte-for-byte unchanged.
#   - The first sed expression normalizes the retired USER_HOME
#     placeholder so old commits and generated histories converge.
#   - $HOME is expanded by the calling shell at exec time. jj does NOT
#     expand env vars in TOML config values, so the jj fix `command =`
#     entry runs through `sh -c` to make HOME resolve on each machine.
#   - `\$HOME` keeps the replacement literal through shell parsing.

set -eu

if [[ -z "${HOME:-}" ]]; then
  echo "generalize-paths: \$HOME is unset" >&2
  exit 2
fi

tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT HUP INT TERM
cat > "$tmp"

encoding=$(file -b --mime-encoding "$tmp")
case "$encoding" in
  us-ascii|utf-8) ;;
  *)
    cat "$tmp"
    exit 0
    ;;
esac

legacy_placeholder='$'
legacy_placeholder="${legacy_placeholder}USER_HOME"

sed \
  -e "s|\\$legacy_placeholder|\$HOME|g" \
  -e "s|$HOME|\$HOME|g" \
  "$tmp"
