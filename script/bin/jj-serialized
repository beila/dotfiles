#!/usr/bin/env bash

set -u

REAL_JJ=${JJ_REAL_EXECUTABLE:?JJ_REAL_EXECUTABLE is required}
FLOCK=${JJ_FLOCK_EXECUTABLE:-flock}
TR=${JJ_TR_EXECUTABLE:-tr}

# sync_repo already owns the local-state lock for its current jj phase.
# Operation-pinned readers cannot snapshot or mutate the working copy, so
# callers that uphold that contract can run without the external sync lock.
if [ "${JJ_SERIALIZED_LOCK_HELD:-0}" = "1" ] ||
   [ "${JJ_SERIALIZED_READ_ONLY:-0}" = "1" ]; then
    exec "$REAL_JJ" "$@"
fi

# Help, version, and completion output never loads the working copy. Shell startup
# runs these commands, so a long sync must not block a new shell.
prev=
for arg in "$@"; do
    [[ $arg != -- ]] || break
    case "$prev $arg" in
        *" -h"|*" --help"|*" --version"|" help"|" version"|"util completion"|"util config-schema"|"util markdown-help"|"util install-man-pages")
            exec "$REAL_JJ" "$@" ;;
    esac
    prev=$arg
done

repo_dir=$PWD
snapshot_options=()
command_args=()
view_args=()
may_page=1
parse_args() {
    local arg value
    while (( $# )); do
        arg=$1
        shift
        case "$arg" in
            --) view_args+=(-- "$@"); break ;;
            -R|--repository|--config|--config-file|--at-op|--at-operation|--color)
                if (( $# == 0 )); then may_page=0; break; fi
                value=$1
                shift
                case $arg in
                    -R|--repository) repo_dir=$value ;;
                    --at-op|--at-operation) snapshot_options+=("$arg" "$value"); continue ;;
                esac
                [[ $arg == --color ]] || snapshot_options+=("$arg" "$value")
                view_args+=("$arg" "$value")
                continue ;;
            --repository=*|-R=*) repo_dir=${arg#*=}; snapshot_options+=("$arg") ;;
            -R?*) repo_dir=${arg#-R}; snapshot_options+=("$arg") ;;
            --config=*|--config-file=*|--ignore-working-copy|--quiet) snapshot_options+=("$arg") ;;
            --at-op=*|--at-operation=*) snapshot_options+=("$arg"); continue ;;
            --no-pager|--no-integrate-operation) may_page=0 ;;
            --color=*|--debug|--ignore-immutable) ;;
            *) command_args+=("$arg") ;;
        esac
        view_args+=("$arg")
    done
}
parse_args "$@"
case "$repo_dir" in
    /*) ;;
    *) repo_dir="$PWD/$repo_dir" ;;
esac

# The read-only probe is safe before locking and gives all workspaces sharing
# a backing Git store the same lock key. Outside a repository, pass through.
if ! git_root=$(cd "$repo_dir" 2>/dev/null && "$REAL_JJ" --ignore-working-copy git root 2>/dev/null); then
    exec "$REAL_JJ" "$@"
fi

lock_key=$(printf '%s' "$git_root" | "$TR" / _)
lockfile="/tmp/sync_repo_${lock_key}.lock"

if [[ -t 1 && $may_page == 1 ]]; then
    command=${command_args[0]:-}
    case $command in
        ''|-r|-r?*|--revision|--revision=*)
            # jj resolves its default command from the launch directory before it applies CLI overrides.
            if default=$("$REAL_JJ" --no-pager config list -T value ui.default-command 2>/dev/null); then
                case $default in
                    ''|'"log"') command=log; view_args=(log "${view_args[@]}") ;;
                esac
            fi ;;
    esac
    case "$command ${command_args[1]:-}" in
        "log "*|"diff "*|"show "*|"status "*|"interdiff "*|"evolog "*|"evolution-log "*|\
        "operation log"|"operation show"|"operation diff"|"op log"|"op show"|"op diff"|\
        "file annotate"|"file list"|"file show"|"file search"|"bookmark list"|"tag list")
            # A view at a specific operation can use its pager after the snapshot lock is released.
            operation=$("$FLOCK" --exclusive --close "$lockfile" "$REAL_JJ" \
                "${snapshot_options[@]}" --no-pager --color=never operation log \
                --limit 1 --no-graph -T 'self.id()') || exit $?
            exec "$REAL_JJ" --at-operation "$operation" "${view_args[@]}" ;;
    esac
fi

# flock remains the lock owner while jj runs, but --close keeps the descriptor
# out of jj and any long-lived child processes it may spawn.
exec "$FLOCK" --exclusive --close "$lockfile" "$REAL_JJ" "$@"
