#!/usr/bin/env bash
# Trace mode for manual debugging: SYNC_REPO_DEBUG=1 sync_repo …
# Off by default — systemd-driven runs are noisy enough already, and the
# leveled logger captures everything important to ~/.local/state/logs/.
if [ "${SYNC_REPO_DEBUG:-0}" = "1" ]; then
    set -x
fi
SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
# Exported for repository hooks. Scheduled sync (sync-repos.service) runs with
# a systemd env that does not carry DOTFILES_ROOT.
export DOTFILES_ROOT=$(dirname "$SCRIPT_DIR")
GIT=${GIT_EXECUTABLE:-git}
FUSER=${FUSER_EXECUTABLE:-fuser}
MACHINE_NAME=$(hostnamectl --pretty 2>/dev/null | grep -v '\.')
MACHINE_NAME=${MACHINE_NAME:-$(hostname -s)}

# SSH hardening for all git/jj subprocesses. ConnectTimeout kills stalled
# handshakes fast; ServerAlive detects half-open connections (VPN drop, proxy
# freeze). BatchMode prevents password prompts that would deadlock under
# systemd. Caller can override by exporting GIT_SSH_COMMAND beforehand.
export GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh -o ConnectTimeout=10 -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -o BatchMode=yes}"

# Outer timeout for each git/jj network call. Catches total process hangs
# that survive ssh-level timeouts (proxy wrappers, DNS stalls, etc.).
SYNC_REPO_CMD_TIMEOUT=${SYNC_REPO_CMD_TIMEOUT:-60}
# Object transfers can exceed the metadata timeout in large repositories.
SYNC_REPO_TRANSFER_TIMEOUT=${SYNC_REPO_TRANSFER_TIMEOUT:-900}
# Remove abandoned Git pack files after one day.
SYNC_REPO_TMP_PACK_MAX_AGE_MINUTES=${SYNC_REPO_TMP_PACK_MAX_AGE_MINUTES:-1440}
# Skip the run below this free space. See step_check_free_space.
SYNC_REPO_MIN_FREE_MB=${SYNC_REPO_MIN_FREE_MB:-1024}
[[ $SYNC_REPO_MIN_FREE_MB =~ ^[0-9]+$ ]] || SYNC_REPO_MIN_FREE_MB=1024

cd "$1" || {
    echo "Error: No such directory as $1"; exit
}

# Silently skip non-jj repos. sync_all blindly hands us every .git/.jj marker
# under $HOME, including Brazil-managed checkouts (~/devc/, ~/.toolbox/) and
# any other plain-git repo. We don't sync those — converting a repo to jj
# (`jj git init --colocate`) is the explicit opt-in. No log line: matches the
# "no sync config" early-exit below in spirit (don't notify on no-ops).
jj --ignore-working-copy root &>/dev/null || exit 0

# Per-repository kill switch. This must be checked with --ignore-working-copy
# before any ordinary jj command: even read-looking commands snapshot @ and
# can race interactive jj use, creating divergent working-copy commits.
SYNC_ENABLED=$(jj --ignore-working-copy config get sync.enabled 2>/dev/null || true)
[ "$SYNC_ENABLED" = "false" ] && exit 0

# Both locks key off the BACKING repo, not the workspace, because multiple jj
# workspaces share one Git store and one jj operation log.
LOCK_PATH=$(jj --ignore-working-copy git root 2>/dev/null || echo "$1")
LOCK_KEY=$(printf '%s' "$LOCK_PATH" | tr / _)
JOB_LOCKFILE="/tmp/sync_repo_job_${LOCK_KEY}.lock"
LOCAL_LOCKFILE="/tmp/sync_repo_${LOCK_KEY}.lock"

# The job lock prevents two sync_repo runs from overlapping. Interactive jj
# never takes this lock, so it remains held while network operations run.
exec 9>"$JOB_LOCKFILE"
# fd 9 is inherited across exec (bash marks neither `9>` nor `{fd}>` as
# close-on-exec), so ANY child that daemonizes keeps the lock alive forever and
# wedges this repo's sync permanently — every later run then exits right here.
# Two real offenders: claude's telemetry sidecar (`claude __otel-server` +
# otelcol-contrib, which reparent to systemd and survive commit-msg's
# `timeout`), and ssh ControlMaster mux processes from git push. Long-lived
# children therefore get `8>&- 9>&-` at their call sites (see run_without_lock).
# Name the holders when we bail so a leak is diagnosable instead of silent.
if ! flock -n 9; then
    holders=$("$FUSER" "$JOB_LOCKFILE" 2>/dev/null | tr -s ' ' || true)
    echo "sync_repo already running for $LOCK_PATH, skipping (lock held by:${holders:- unknown})"
    exit 0
fi

# The local-state lock is shared with Home Manager's jj wrapper. Hold it only
# while reading or mutating jj/Git refs; release it for network transfer.
exec 8>"$LOCAL_LOCKFILE"
LOCAL_LOCK_HELD=0

acquire_local_lock() {
    [ "$LOCAL_LOCK_HELD" = "1" ] && return 0
    flock 8
    LOCAL_LOCK_HELD=1
    export JJ_SERIALIZED_LOCK_HELD=1
}

release_local_lock() {
    [ "$LOCAL_LOCK_HELD" = "0" ] && return 0
    export JJ_SERIALIZED_LOCK_HELD=0
    flock -u 8
    LOCAL_LOCK_HELD=0
}

acquire_local_lock

# Run a command with both descriptors closed so a daemonizing child cannot
# inherit either lock. The parent retains whichever locks it currently owns.
run_without_lock() {
    "$@" 8>&- 9>&-
}

# --- structured logging + error classification --------------------------------
# Use log.sh's local default (~/.local/state/logs/) instead of the inherited
# ~/hjdocs/logs/, since this script syncs ~/hjdocs itself. Tests opt out via
# SYNC_LOG_ROOT_KEEP=1 to pin a tempdir.
if [ "${SYNC_LOG_ROOT_KEEP:-0}" != "1" ]; then
    unset LOG_ROOT LOG_REL_BASE LOG_NOTIFY_DEDUP_DIR
fi
LOG_TAG=sync_repo
# LOG_CONTEXT disambiguates between multiple workspaces / worktrees of the
# same repo. If we tried to use just `basename "$LOCK_PATH"` we'd get e.g.
# "IgnitionX" from both ~/dev/pro/src/IgnitionX and ~/dev/pro2/src/IgnitionX
# and the log files would collide.
#
# Strategy: take the path relative to $HOME, drop any 'dev/' / 'brazil-repos/'
# prefix noise, replace '/' with '-'. Keeps log file names short and unique.
_rel_home=${LOCK_PATH#$HOME/}
_rel_home=${_rel_home#dev/}
_rel_home=${_rel_home#brazil-repos/}
LOG_CONTEXT=$(printf '%s' "$_rel_home" | tr / -)
# shellcheck source=/dev/null
source "$DOTFILES_ROOT/script/logger/log.sh"

# _summarize_stderr <file>
# Pluck the most informative lines from a captured stderr file for the one-line
# summary in the structured ERROR/WARN log. Strips the `remote: ` prefix that
# git prepends to server output, drops blank lines, and joins the first 4
# survivors with ` | `. Without this, gitfarm pushes log only the generic
# "We're sorry, we failed to handle your request!" banner — the actual reason
# (no-description rejection, GuardRails block, log id, etc.) lives on lines
# 3+ and gets truncated by `head -2`.
_summarize_stderr() {
    sed -E 's/\r$//; s/^remote:[[:space:]]*//' "$1" \
        | awk 'NF > 0' \
        | head -4 \
        | tr '\n' '|' \
        | sed -E 's/\|$//; s/\|/ | /g'
}

rebase_with_diagnostics() {
    local bookmark=$1 local_rev=$2 remote_rev=$3 sources=$4 err rc line
    shift 4
    err=$(mktemp "/tmp/sync_repo_err.XXXXXX") || return 1
    jj rebase -s "$sources" -d "$remote_rev" "$@" 2>"$err"
    rc=$?
    if [ "$rc" -ne 0 ]; then
        log CRITICAL "REBASE-FAIL $bookmark local=$local_rev remote=$remote_rev: $(_summarize_stderr "$err")"
        log DEBUG "STDERR-BEGIN rebase $bookmark"
        while IFS= read -r line; do
            log DEBUG "  $line"
        done < "$err"
        log DEBUG "STDERR-END rebase $bookmark"
        cat "$err" >&2
    fi
    rm -f "$err"
    return "$rc"
}

# classify_cmd <tag> <cmd...>
# Run <cmd...>, capture stderr, classify failure as NETWORK (usually transient
# -> WARN) or OTHER (-> ERROR). Returns the original exit code.
# Sets $_LAST_CLASSIFICATION to OK / TIMEOUT / BENIGN-DEL / NETWORK-ERR / OTHER-ERR
# so callers can branch on the kind of failure (e.g. push_force_replace only
# proceeds with the push if the preceding delete was successful or benign).
# Network-pattern heuristics based on git/ssh/curl error strings.
_LAST_CLASSIFICATION=""
# Transient failures: the next run retries, so they log at WARN without a notification.
# 'Another user is currently pushing' is gitfarm's message when the repo is locked by a
# concurrent git-receive-pack. 'fine to retry your request' ends gitfarm's internal-error
# banner. GitHub answers a server failure with an HTTP 5xx reason phrase and a request ID
# (electra, 2026-11-02: "Internal Server Error | Request ID …"). Permanent rejections
# (no-description, GuardRails, protected branch) use different wording and stay OTHER-ERR.
TRANSIENT_ERR_RE='Could not resolve hostname|Could not read from remote repository|Connection (refused|timed out|reset)|Network is unreachable|No route to host|Temporary failure in name resolution|kex_exchange_identification|Operation timed out|Failed to connect to|SSL_ERROR|remote end hung up|RPC failed|Another user is currently pushing|fine to retry your request|Internal Server Error|Bad Gateway|Service Unavailable|Gateway Time-?out'
classify_cmd() {
    local tag=$1; shift
    local err rc
    err=$(mktemp "/tmp/sync_repo_err.XXXXXX")
    "$@" 2>"$err"
    rc=$?
    _LAST_CLASSIFICATION=OK
    if [ $rc -ne 0 ]; then
        if [ $rc -eq 124 ] || [ $rc -eq 137 ]; then
            # timeout(1) exit codes: 124 (SIGTERM expired), 137 (SIGKILL after grace).
            _LAST_CLASSIFICATION=TIMEOUT
            log WARN "TIMEOUT $tag: exceeded ${SYNC_REPO_ACTIVE_TIMEOUT:-$SYNC_REPO_CMD_TIMEOUT}s; killed"
        elif grep -qE 'remote ref does not exist|unable to delete.*remote ref|does not appear to be a git repository' "$err"; then
            # Benign: deleting a branch that isn't on the remote. Happens on
            # every run for push-del of hostname-prefixed snapshots after their
            # first failed push, or when a snapshot was never pushed. Log at
            # DEBUG so we keep a trace without paging anyone.
            _LAST_CLASSIFICATION=BENIGN-DEL
            log DEBUG "BENIGN-DEL $tag: $(head -1 "$err")"
        elif grep -qE "$TRANSIENT_ERR_RE" "$err"; then
            _LAST_CLASSIFICATION=NETWORK-ERR
            log WARN "NETWORK-ERR $tag: $(_summarize_stderr "$err")"
        else
            _LAST_CLASSIFICATION=OTHER-ERR
            log ERROR "OTHER-ERR $tag (rc=$rc): $(_summarize_stderr "$err")"
        fi
        # Fold the full stderr into the structured log at DEBUG so the file the
        # notification links to actually contains the diagnosis. The summary
        # line above is lossy by design (gitfarm/git/curl errors run 10+ lines);
        # this preserves everything for post-hoc inspection without raising the
        # notification body length. DEBUG never re-notifies and never raises the
        # keep threshold beyond what the ERROR/WARN call already did.
        if [ -s "$err" ]; then
            log DEBUG "STDERR-BEGIN $tag"
            while IFS= read -r _stderr_line; do
                log DEBUG "  $_stderr_line"
            done < "$err"
            log DEBUG "STDERR-END $tag"
        fi
        # Forward stderr to the process stderr so set -x / systemd journal still see it
        cat "$err" >&2
    fi
    rm -f "$err"
    return $rc
}

# try_atomic_force_replace <tag> <url> <commit> <branch> <expected>
# Return 2 only when the server rejects force updates.
try_atomic_force_replace() {
    local tag=$1 url=$2 commit=$3 branch=$4 expected=$5
    local err rc summary
    case "$SYNC_REPO_TRANSFER_TIMEOUT" in
        "" | *[!0-9]*)
            log ERROR "BAD-CONFIG SYNC_REPO_TRANSFER_TIMEOUT='$SYNC_REPO_TRANSFER_TIMEOUT' must be a non-negative integer"
            return 1
            ;;
    esac
    err=$(mktemp "/tmp/sync_repo_err.XXXXXX") || return 1
    run_without_lock timeout --kill-after=10 "$SYNC_REPO_TRANSFER_TIMEOUT" \
        env GIT_ALTERNATE_OBJECT_DIRECTORIES="$GIT_DIR/objects" \
        "$GIT" --git-dir="$PUSH_GIT_DIR" push \
        "--force-with-lease=${branch}:${expected}" "$url" "${commit}:${branch}" \
        2>"$err"
    rc=$?
    if [ "$rc" -eq 0 ]; then
        rm -f "$err"
        return 0
    fi

    summary=$(_summarize_stderr "$err")
    if [ "$rc" -eq 124 ] || [ "$rc" -eq 137 ]; then
        log WARN "TIMEOUT force-push $tag: exceeded ${SYNC_REPO_TRANSFER_TIMEOUT}s; killed"
    elif grep -qiE 'stale info|cannot lock ref.*expected' "$err"; then
        log INFO "SKIP-PUSH $tag: remote moved after discovery; will retry next run"
    elif grep -qE "$TRANSIENT_ERR_RE" "$err"; then
        log WARN "NETWORK-ERR force-push $tag: $summary"
    elif grep -qiE '(force|forced).*(denied|not allowed|prohibited|disabled|reject)|pre-receive hook declined' "$err"; then
        log DEBUG "ATOMIC-REPLACE-UNAVAILABLE $tag: $summary"
        rm -f "$err"
        return 2
    else
        log ERROR "OTHER-ERR force-push $tag (rc=$rc): $summary"
    fi
    cat "$err" >&2
    rm -f "$err"
    return 1
}

# push_force_replace <tag> <url> <commit> <branch> <expected>
# Prefer an atomic leased update. Serialize the delete fallback because Git
# temporarily deletes a matching remote-tracking ref.
push_force_replace() {
    local tag=$1 url=$2 commit=$3 branch=$4 expected=$5
    local atomic_rc del_class fallback_rc=1 release_after=0
    try_atomic_force_replace "$tag" "$url" "$commit" "$branch" "$expected"
    atomic_rc=$?
    [ "$atomic_rc" -eq 0 ] && return 0
    [ "$atomic_rc" -eq 2 ] || return 1

    if [ "$LOCAL_LOCK_HELD" = "0" ]; then
        acquire_local_lock
        release_after=1
    fi
    transfer_cmd "push-del $tag" env GIT_ALTERNATE_OBJECT_DIRECTORIES="$GIT_DIR/objects" \
        "$GIT" --git-dir="$PUSH_GIT_DIR" push "$url" --delete "$branch"
    del_class=$_LAST_CLASSIFICATION
    case "$del_class" in
        OK)
            if transfer_cmd "push $tag" env GIT_ALTERNATE_OBJECT_DIRECTORIES="$GIT_DIR/objects" \
                "$GIT" --git-dir="$PUSH_GIT_DIR" push "$url" "${commit}:${branch}"; then
                fallback_rc=0
            fi
            ;;
        *)
            log WARN "SKIP-PUSH $tag: delete failed (${del_class:-unknown}); will retry next run"
            ;;
    esac
    [ "$release_after" = "0" ] || release_local_lock
    return "$fallback_rc"
}

# timeout_cmd <tag> <cmd...>
# classify_cmd wrapped in timeout(1). --kill-after sends SIGKILL 10s after
# the initial SIGTERM if the child refuses to die. Total max wall time:
# $SYNC_REPO_CMD_TIMEOUT + 10s.
timeout_cmd() {
    local tag=$1; shift
    SYNC_REPO_ACTIVE_TIMEOUT=$SYNC_REPO_CMD_TIMEOUT \
        classify_cmd "$tag" run_without_lock timeout --kill-after=10 "$SYNC_REPO_CMD_TIMEOUT" "$@"
}

list_tmp_pack_files() {
    local pack_dir="$GIT_DIR/objects/pack" path
    local restore_nullglob=1
    [ -d "$pack_dir" ] || return 0
    shopt -q nullglob && restore_nullglob=0
    shopt -s nullglob
    for path in "$pack_dir"/tmp_pack_*; do
        [ -f "$path" ] && [ ! -L "$path" ] && printf '%s\n' "$path"
    done | LC_ALL=C sort
    [ "$restore_nullglob" = "0" ] || shopt -u nullglob
}

remove_tmp_pack_files() {
    local reason=$1 path blocks fuser_rc
    local pack_dir="$GIT_DIR/objects/pack"
    local count=0 bytes=0
    shift
    [ "$#" -gt 0 ] || return 0
    if ! command -v "$FUSER" >/dev/null 2>&1; then
        log WARN "TMP-PACK-CLEANUP-SKIP $reason: fuser is unavailable"
        return 0
    fi
    for path in "$@"; do
        [ "${path%/*}" = "$pack_dir" ] || continue
        case "${path##*/}" in
            tmp_pack_*) ;;
            *) continue ;;
        esac
        [ -f "$path" ] && [ ! -L "$path" ] || continue
        "$FUSER" -s "$path" 2>/dev/null
        fuser_rc=$?
        case "$fuser_rc" in
            0) continue ;;
            1) ;;
            *)
                log WARN "TMP-PACK-CLEANUP-SKIP $reason: cannot inspect ${path##*/}"
                continue
                ;;
        esac
        blocks=$(stat -c %b "$path" 2>/dev/null) || continue
        if rm -f -- "$path"; then
            count=$((count + 1))
            bytes=$((bytes + blocks * 512))
        fi
    done
    if [ "$count" -gt 0 ]; then
        log INFO "TMP-PACK-CLEANUP $reason: removed=$count reclaimed-bytes=$bytes"
    fi
}

cleanup_stale_tmp_packs() {
    local now cutoff path mtime
    local -a stale=()
    case "$SYNC_REPO_TMP_PACK_MAX_AGE_MINUTES" in
        "" | *[!0-9]*)
            log ERROR "BAD-CONFIG SYNC_REPO_TMP_PACK_MAX_AGE_MINUTES='$SYNC_REPO_TMP_PACK_MAX_AGE_MINUTES' must be a non-negative integer"
            return 1
            ;;
    esac
    now=$(date +%s)
    cutoff=$((now - SYNC_REPO_TMP_PACK_MAX_AGE_MINUTES * 60))
    while IFS= read -r path; do
        mtime=$(stat -c %Y "$path" 2>/dev/null) || continue
        [ "$mtime" -le "$cutoff" ] && stale+=("$path")
    done < <(list_tmp_pack_files)
    remove_tmp_pack_files "stale" "${stale[@]}"
}

# Use a longer timeout for object transfers. Remove only new abandoned packs.
transfer_cmd() {
    local tag=$1 before after rc
    local -a created=()
    shift
    case "$SYNC_REPO_TRANSFER_TIMEOUT" in
        "" | *[!0-9]*)
            log ERROR "BAD-CONFIG SYNC_REPO_TRANSFER_TIMEOUT='$SYNC_REPO_TRANSFER_TIMEOUT' must be a non-negative integer"
            _LAST_CLASSIFICATION=OTHER-ERR
            return 1
            ;;
    esac
    before=$(mktemp "/tmp/sync_repo_packs_before.XXXXXX") || {
        log ERROR "TMP-PACK-SNAPSHOT-FAIL $tag: cannot create the before file"
        _LAST_CLASSIFICATION=OTHER-ERR
        return 1
    }
    after=$(mktemp "/tmp/sync_repo_packs_after.XXXXXX") || {
        log ERROR "TMP-PACK-SNAPSHOT-FAIL $tag: cannot create the after file"
        rm -f "$before"
        _LAST_CLASSIFICATION=OTHER-ERR
        return 1
    }
    list_tmp_pack_files >"$before"
    SYNC_REPO_ACTIVE_TIMEOUT=$SYNC_REPO_TRANSFER_TIMEOUT \
        classify_cmd "$tag" run_without_lock timeout --kill-after=10 "$SYNC_REPO_TRANSFER_TIMEOUT" "$@"
    rc=$?
    if [ "$rc" -ne 0 ] && [ "$_LAST_CLASSIFICATION" = "TIMEOUT" ]; then
        list_tmp_pack_files >"$after"
        mapfile -t created < <(comm -13 "$before" "$after")
        remove_tmp_pack_files "timeout $tag" "${created[@]}"
    fi
    rm -f "$before" "$after"
    return "$rc"
}

# --- repository hooks ---------------------------------------------------------
# Optional per-repository commands, set in jj config like the other sync.* keys:
#   sync.pre-snapshot  runs before the first working-copy snapshot of the run.
#   sync.post-update   runs at the end, after fetch and rebase can change the working copy.
# Each value is one shell command. It runs in the workspace root with the local-state
# lock held. JJ_SERIALIZED_LOCK_HELD=1 is exported, so a jj command in the hook does not
# wait for that lock. The caller decides whether a failure stops the run.
run_sync_hook() {
    local name=$1 cmd root err rc
    cmd=$(jj --ignore-working-copy config get "sync.$name" 2>/dev/null) || return 0
    [ -n "$cmd" ] || return 0
    root=$(jj --ignore-working-copy root 2>/dev/null) || root=$PWD
    err=$(mktemp "/tmp/sync_repo_err.XXXXXX") || return 1
    (cd "$root" && run_without_lock timeout --kill-after=10 "$SYNC_REPO_CMD_TIMEOUT" sh -c "$cmd") \
        >/dev/null 2>"$err"
    rc=$?
    if [ $rc -ne 0 ]; then
        log ERROR "HOOK-FAIL sync.$name (rc=$rc): $(_summarize_stderr "$err")"
        cat "$err" >&2
    else
        log DEBUG "HOOK-OK sync.$name"
    fi
    rm -f "$err"
    return "$rc"
}

# --- home-directory templates -------------------------------------------------
# script/bin/home-template keeps the home directory of this machine out of pushed
# commits. Its stdout lines are changes and go to the log at INFO. It reads the file
# list of large repositories several times, so it has its own, longer timeout.
HOME_TEMPLATE_TIMEOUT=${HOME_TEMPLATE_TIMEOUT:-300}
run_home_template() {
    local step=$1 out err rc line
    out=$(mktemp "/tmp/sync_repo_out.XXXXXX") || return 1
    err=$(mktemp "/tmp/sync_repo_err.XXXXXX") || {
        rm -f "$out"
        return 1
    }
    run_without_lock timeout --kill-after=10 "$HOME_TEMPLATE_TIMEOUT" \
        "$DOTFILES_ROOT/script/bin/home-template" "$step" >"$out" 2>"$err"
    rc=$?
    while IFS= read -r line; do
        log INFO "HOME-TEMPLATE $step: $line"
    done <"$out"
    if [ $rc -ne 0 ]; then
        log ERROR "HOME-TEMPLATE-FAIL $step (rc=$rc): $(_summarize_stderr "$err")"
        cat "$err" >&2
    fi
    rm -f "$out" "$err"
    return "$rc"
}

# --- jj branch helpers --------------------------------------------------------
# Step functions read these globals (set in main):
#   PUSH_REV, GIT_DIR, WORKSPACE_NAME, SNAPSHOT_URL, SYNC_BM, SYNC_REMOTE,
#   MACHINE_NAME, DOTFILES_ROOT, SYNC_REPO_CMD_TIMEOUT.

# Pick a stable single-rev change_id even when @ is an empty merge. One jj
# call to snapshot @ avoids races with concurrent jj.
snapshot_at_to_push_rev() {
    local at_info change_id is_empty is_merge has_desc parent_change_id msg
    at_info=$(jj log -r @ --no-graph -T 'change_id ++ "|" ++ if(empty, "1", "0") ++ "|" ++ if(parents.len() > 1, "1", "0") ++ "|" ++ if(description, "1", "0") ++ "|" ++ parents.map(|p| p.change_id()).join(",")' 2>/dev/null)
    IFS='|' read -r change_id is_empty is_merge has_desc parent_change_id <<<"$at_info"
    if [ "$is_empty" = "0" ] || [ "$is_merge" = "1" ]; then
        jj new
        if [ "$is_empty" = "0" ] && [ "$has_desc" = "0" ]; then
            if ! msg=$(VERBOSE=1 run_without_lock "$DOTFILES_ROOT/bin/commit-msg" "$change_id"); then
                echo "commit-msg failed" >&2
                exit 1
            fi
            jj describe "$change_id" -m "$msg"
        fi
        PUSH_REV=$change_id
    else
        PUSH_REV=$parent_change_id
    fi
}

# Generate descriptions for any descriptionless mutable commits in the local
# chain. gitfarm's pre-receive hook rejects pushes that contain undescribed
# commits ("Won't push commit X since it has no description"); so does any
# other server with a similar policy. snapshot_at_to_push_rev only describes
# @ when it's empty-and-fresh; older mutable commits made outside this script
# (interactive `jj new`, agent edits, etc.) can still be undescribed, and the
# rebase in handle_diverged carries that forward unchanged.
#
# Revset: the local-only chain when a remote bookmark is configured, else
# just @-. Skips empty commits (they can't be
# described meaningfully and aren't pushed by gitfarm anyway).
step_describe_local_chain() {
    local revset="@-"
    if [ -n "$SYNC_BM" ]; then
        if jj log -r "${SYNC_BM}@${SYNC_REMOTE}" --no-graph -T '"y"' 2>/dev/null | grep -q y; then
            revset="${SYNC_BM}@${SYNC_REMOTE}..@-"
        fi
    fi
    local commit_id change_id msg err
    # Address each commit by its commit ID. A divergent change ID resolves to
    # more than one commit, so jj rejects it. jj lists children before
    # parents. Thus a describe changes only commits that the loop already did.
    while IFS=' ' read -r commit_id change_id; do
        [ -n "$commit_id" ] || continue
        if ! msg=$(run_without_lock "$DOTFILES_ROOT/bin/commit-msg" "$commit_id" 2>/dev/null); then
            log WARN "DESCRIBE-FAIL $change_id ($commit_id): commit-msg failed; leaving undescribed"
            continue
        fi
        # commit-msg always falls back to a file-list, so empty output is
        # an unexpected pipeline break — log and skip to avoid setting an
        # empty description (jj describe -m '' clears the description).
        [ -n "$msg" ] || { log WARN "DESCRIBE-FAIL $change_id ($commit_id): empty commit-msg output"; continue; }
        if err=$(jj describe "$commit_id" -m "$msg" 2>&1 >/dev/null); then
            log INFO "DESCRIBE-OK $change_id: $msg"
        else
            log WARN "DESCRIBE-FAIL $change_id ($commit_id): jj describe failed: $(printf '%s\n' "$err" | _summarize_stderr /dev/stdin)"
        fi
    done < <(jj log -r "$revset" --no-graph -T 'if(!description && !empty, commit_id ++ " " ++ change_id ++ "\n")' 2>/dev/null)
}

# `jj git root` is authoritative now that the script only handles jj repos.
# Step 2's `jj workspace update-stale` (run before this) ensures the op log
# is fresh, so transient stale-view failures are rare and self-recover on the
# next cycle.
resolve_git_dir() {
    GIT_DIR=$LOCK_PATH
}

prepare_push_transport() {
    PUSH_GIT_DIR=$(mktemp -d "/tmp/sync_repo_push_git.XXXXXX") || exit 1
    "$GIT" init --bare -q "$PUSH_GIT_DIR" || exit 1
}

cleanup_push_transport() {
    local rc=$?
    log_finalize
    case "${PUSH_GIT_DIR:-}" in
        /tmp/sync_repo_push_git.*) rm -rf -- "$PUSH_GIT_DIR" ;;
    esac
    return "$rc"
}

# Find which workspace this run is operating on. Multiple workspaces share
# one `.jj/repo` store + op log (e.g. ~/dev/{pro,pro2}/src/IgnitionX both
# share ~/brazil-repos/IgnitionX/.jj), so the only signal that distinguishes
# "which workspace am I in" is matching @'s commit_id against the per-
# workspace target_id from `jj workspace list`. Sets WORKSPACE_NAME (empty
# if no match — caller decides whether that's fatal).
resolve_workspace_name() {
    local at_commit
    at_commit=$(jj log -r @ --no-graph -T 'commit_id' 2>/dev/null)
    WORKSPACE_NAME=$(jj workspace list -T 'self.name() ++ " " ++ self.target().commit_id() ++ "\n"' 2>/dev/null | awk -v c="$at_commit" '$2 == c {print $1; exit}')
}

# Detect files jj refuses to snapshot (size limit). Such files silently
# bypass the entire sync — surface as ERROR so the user can either delete
# the file or raise snapshot.max-new-file-size for this repo.
# The refusal stays until the user acts, so each run logs it again. Notify
# again only after a longer window than the transient-error default.
SYNC_REFUSED_SNAPSHOT_DEDUP_WINDOW=${SYNC_REFUSED_SNAPSHOT_DEDUP_WINDOW:-86400}
check_refused_snapshots() {
    local err
    local LOG_NOTIFY_DEDUP_WINDOW=$SYNC_REFUSED_SNAPSHOT_DEDUP_WINDOW
    err=$(jj status 2>&1 1>/dev/null)
    if echo "$err" | grep -q "Refused to snapshot"; then
        local files
        files=$(echo "$err" | awk '
            /Refused to snapshot/ { flag=1; next }
            flag && /^  / && /bytes\)/ {
                sub(/^  /, ""); sub(/:.*$/, ""); print
            }
        ' | tr '\n' ' ')
        log ERROR "REFUSED-SNAPSHOT not backed up: ${files}(raise snapshot.max-new-file-size or delete the file)"
    fi
}

# --- Snapshot push (purely additive — no local changes) -----------------------
# Writes per-host snapshots of the working state to refs/heads/<MACHINE>/<NAME>
# on the snapshot URL via raw git. Two reasons to push directly to the URL
# instead of through a configured remote:
#   1. No local refs/remotes/<remote>/* tracking refs get updated, so jj never
#      imports these snapshots as remote bookmarks. The `jj log` and
#      `jj bookmark list` views stay clean.
#   2. The script doesn't need a `backup` remote configured in either git or
#      jj — sync.snapshot-url is the single source of truth.
#
# The snapshot is the safety net: it MUST run BEFORE prepare_bookmark_sync
# touches local state (rebase / bookmark advance / etc.), so a botched
# bookmark sync never destroys work that hasn't been backed up.
declare -A SNAPSHOT_REMOTE_COMMITS=()
SNAPSHOT_REMOTE_REFS_READY=0
declare -a SNAPSHOT_TAGS=() SNAPSHOT_COMMITS=() SNAPSHOT_BRANCHES=()

# Query all snapshots for this host once. A failed discovery skips the whole
# snapshot batch: retrying delete+push for every bookmark would multiply one
# network outage into minutes of unnecessary network delay.
load_snapshot_remote_refs() {
    [ -n "$SNAPSHOT_URL" ] || return 0
    local output commit ref
    if ! output=$(timeout_cmd "snapshot-refs ${MACHINE_NAME}" \
        "$GIT" ls-remote --heads "$SNAPSHOT_URL" "refs/heads/${MACHINE_NAME}/*" \
            "refs/heads/*/${REPO_HISTORY_REF_NAME}"); then
        log WARN "SKIP-PUSH snapshots: remote ref query failed; will retry next run"
        return 1
    fi
    while read -r commit ref; do
        [ -n "$commit" ] && [ -n "$ref" ] || continue
        SNAPSHOT_REMOTE_COMMITS["$ref"]=$commit
    done <<<"$output"
    SNAPSHOT_REMOTE_REFS_READY=1
}

# Push only refs whose remote commit differs. New refs need one direct push;
# existing refs still use delete+push because gitfarm rejects force pushes.
push_snapshot_ref() {
    local tag=$1 commit=$2 branch=$3
    [ "$SNAPSHOT_REMOTE_REFS_READY" = "1" ] || return 0
    local remote_commit=${SNAPSHOT_REMOTE_COMMITS["$branch"]:-}
    if [ "$remote_commit" = "$commit" ]; then
        log DEBUG "SKIP $tag: snapshot unchanged"
        return 0
    fi

    if [ -z "$remote_commit" ]; then
        transfer_cmd "push $tag" env GIT_ALTERNATE_OBJECT_DIRECTORIES="$GIT_DIR/objects" \
            "$GIT" --git-dir="$PUSH_GIT_DIR" push \
            "$SNAPSHOT_URL" "${commit}:${branch}" || return 1
    else
        push_force_replace "$tag" "$SNAPSHOT_URL" "$commit" "$branch" "$remote_commit" || return 1
    fi
    SNAPSHOT_REMOTE_COMMITS["$branch"]=$commit
}

# Resolve every local revision while the local-state lock is held. The network
# phase consumes only these immutable Git commit IDs and never calls jj.
prepare_snapshot_refs() {
    [ -n "$SNAPSHOT_URL" ] || return 0
    local current_commit bm ref
    if [ -n "$WORKSPACE_NAME" ]; then
        current_commit=$(jj log -r "$PUSH_REV" --no-graph -T 'commit_id' 2>/dev/null)
        if [ -n "$current_commit" ]; then
            SNAPSHOT_TAGS+=("${MACHINE_NAME}/${WORKSPACE_NAME}")
            SNAPSHOT_COMMITS+=("$current_commit")
            SNAPSHOT_BRANCHES+=("refs/heads/${MACHINE_NAME}/${WORKSPACE_NAME}")
        fi
    fi

    # Local bookmarks are repo-scoped, so only the default workspace captures
    # them. Other workspaces still capture their own workspace snapshot above.
    [ "$WORKSPACE_NAME" = "default" ] || return 0
    while IFS=$'\t' read -r bm ref; do
        [ -n "$bm" ] && [ -n "$ref" ] || continue
        case "$bm" in
            "${MACHINE_NAME}/"*) continue ;;
        esac
        SNAPSHOT_TAGS+=("${MACHINE_NAME}/${bm}")
        SNAPSHOT_COMMITS+=("$ref")
        SNAPSHOT_BRANCHES+=("refs/heads/${MACHINE_NAME}/${bm}")
    done < <(
        jj bookmark list \
            -T 'name ++ "\t" ++ if(normal_target, normal_target.commit_id(), "") ++ "\n"' \
            2>/dev/null | sort -u
    )
}

push_prepared_snapshots() {
    local i
    for ((i = 0; i < ${#SNAPSHOT_TAGS[@]}; i++)); do
        push_snapshot_ref "${SNAPSHOT_TAGS[$i]}" "${SNAPSHOT_COMMITS[$i]}" "${SNAPSHOT_BRANCHES[$i]}"
    done
}

# shellcheck source=/dev/null
source "$SCRIPT_DIR/lib/sync-repo-history.sh"

# --- Sync-bookmark sync -------------------------------------------------------
# Network fetch/push uses raw Git while the local-state lock is released.
# Updating Git tracking refs, importing them into jj, and all reconciliation
# stay inside the local-state lock.

SYNC_REMOTE_AVAILABLE=0
REMOTE_FETCH_OK=1
REMOTE_FETCH_OID=""
REMOTE_TRACKING_BEFORE=""
REMOTE_FETCH_URL=""
REMOTE_PUSH_URL=""
REMOTE_TRACKING_REF=""
BOOKMARK_PUSH_OID=""
BOOKMARK_PUSH_KIND=""
BOOKMARK_PUSH_EXPECTED_OID=""
BOOKMARK_PUSH_LOG_SUFFIX=""
BOOKMARK_PUSH_SUCCEEDED=0

prepare_remote_transport() {
    [ -n "$SYNC_BM" ] || return 0
    local remotes
    if ! remotes=$(jj git remote list 2>/dev/null); then
        log ERROR "REMOTE-LIST-FAIL ${SYNC_BM}@${SYNC_REMOTE}: jj git remote list failed; skipping bookmark sync"
        return 0
    fi
    if ! printf '%s\n' "$remotes" | awk '{print $1}' | grep -qx "$SYNC_REMOTE"; then
        log INFO "SKIP ${SYNC_BM}@${SYNC_REMOTE}: remote '${SYNC_REMOTE}' not configured"
        return 0
    fi

    if ! REMOTE_FETCH_URL=$($GIT --git-dir="$GIT_DIR" remote get-url "$SYNC_REMOTE" 2>/dev/null); then
        log ERROR "REMOTE-LIST-FAIL ${SYNC_BM}@${SYNC_REMOTE}: git remote URL lookup failed; skipping bookmark sync"
        return 0
    fi
    REMOTE_PUSH_URL=$($GIT --git-dir="$GIT_DIR" remote get-url --push "$SYNC_REMOTE" 2>/dev/null || printf '%s' "$REMOTE_FETCH_URL")
    REMOTE_TRACKING_REF="refs/remotes/${SYNC_REMOTE}/${SYNC_BM}"
    REMOTE_TRACKING_BEFORE=$($GIT --git-dir="$GIT_DIR" rev-parse --verify -q "$REMOTE_TRACKING_REF" 2>/dev/null || true)
    SYNC_REMOTE_AVAILABLE=1
}

# Discover the remote tip, then fetch its objects by URL without a destination
# ref or FETCH_HEAD. This leaves every local ref untouched while the local lock
# is open for interactive jj commands.
fetch_remote_bookmark_objects() {
    [ "$SYNC_REMOTE_AVAILABLE" = "1" ] || return 0
    local output
    if ! output=$(timeout_cmd "fetch-head ${SYNC_BM}@${SYNC_REMOTE}" \
        "$GIT" ls-remote --heads "$REMOTE_FETCH_URL" "refs/heads/${SYNC_BM}"); then
        REMOTE_FETCH_OK=0
        log INFO "SKIP-PUSH ${SYNC_BM}: fetch failed; will retry next run"
        return 0
    fi
    REMOTE_FETCH_OID=$(printf '%s\n' "$output" | awk 'NR == 1 { print $1 }')
    if [ -n "$REMOTE_FETCH_OID" ] && ! transfer_cmd "fetch ${SYNC_BM}@${SYNC_REMOTE}" \
        "$GIT" --git-dir="$GIT_DIR" fetch --no-tags --no-write-fetch-head \
        --no-auto-maintenance "$REMOTE_FETCH_URL" "refs/heads/${SYNC_BM}"; then
        REMOTE_FETCH_OK=0
        log INFO "SKIP-PUSH ${SYNC_BM}: fetch failed; will retry next run"
    fi
}

# Keep remote reference updates from abandoning commits and rebasing their descendants.
import_tracking_refs() {
    jj --config git.abandon-unreachable-commits=false git import --ignore-working-copy
}

# Publish the fetched tip to the normal Git remote-tracking ref and import it
# into jj. Preserve a ref changed by another Git process while the lock was
# released; the next ancestry check must use the actual imported tip.
apply_fetched_remote() {
    [ "$SYNC_REMOTE_AVAILABLE" = "1" ] || return 0
    [ "$REMOTE_FETCH_OK" = "1" ] || return 0
    local current expected_zero=0000000000000000000000000000000000000000
    current=$($GIT --git-dir="$GIT_DIR" rev-parse --verify -q "$REMOTE_TRACKING_REF" 2>/dev/null || true)
    if [ "$current" = "$REMOTE_TRACKING_BEFORE" ]; then
        if [ -n "$REMOTE_FETCH_OID" ]; then
            $GIT --git-dir="$GIT_DIR" update-ref "$REMOTE_TRACKING_REF" \
                "$REMOTE_FETCH_OID" "${current:-$expected_zero}" 2>/dev/null || true
        elif [ -n "$current" ]; then
            $GIT --git-dir="$GIT_DIR" update-ref -d "$REMOTE_TRACKING_REF" "$current" 2>/dev/null || true
        fi
    fi
    import_tracking_refs >/dev/null 2>&1 || {
        log ERROR "REMOTE-IMPORT-FAIL ${SYNC_BM}@${SYNC_REMOTE}: jj git import failed; skipping bookmark sync"
        REMOTE_FETCH_OK=0
        return 0
    }
    log INFO "FETCH-OK ${SYNC_BM}@${SYNC_REMOTE}"
}

queue_bookmark_push() {
    local range count
    # Do not publish a conflict. On 2026-11-01 a failed rebase was followed by a
    # rebase with conflicts, and the next run pushed that chain to the shared bookmark.
    # A conflict in an older commit that a later commit resolved stays in history.
    if [ -n "$(jj log -r "$2 & conflicts()" --no-graph -T '"c"' 2>/dev/null)" ]; then
        log ERROR "SKIP-PUSH ${SYNC_BM}@${SYNC_REMOTE}: the commit to push has a conflict ($2); resolve it, then the next run pushes"
        SYNC_CONFLICT=1
        return 0
    fi
    if [ -n "$3" ]; then
        range="$3..$2"
    else
        range="::$2 ~ ::remote_bookmarks() ~ root()"
    fi
    count=$(jj log -r "($range) & conflicts()" --no-graph -T '"c\n"' 2>/dev/null | grep -c c)
    [ "$count" -gt 0 ] && log WARN "PUSH-HISTORY-CONFLICTS ${SYNC_BM}@${SYNC_REMOTE}: $count older commits have conflicts that later commits resolved"
    BOOKMARK_PUSH_KIND=$1
    BOOKMARK_PUSH_OID=$2
    BOOKMARK_PUSH_EXPECTED_OID=$3
    BOOKMARK_PUSH_LOG_SUFFIX=$4
}

push_prepared_bookmark() {
    [ -n "$BOOKMARK_PUSH_OID" ] || return 0
    if transfer_cmd "push ${SYNC_BM} (${BOOKMARK_PUSH_KIND})" \
        env GIT_ALTERNATE_OBJECT_DIRECTORIES="$GIT_DIR/objects" \
        "$GIT" --git-dir="$PUSH_GIT_DIR" push "$REMOTE_PUSH_URL" \
        "${BOOKMARK_PUSH_OID}:refs/heads/${SYNC_BM}"; then
        BOOKMARK_PUSH_SUCCEEDED=1
    fi
}

# A URL push intentionally does not update local remote-tracking refs. After a
# successful push, update/import the ref under the local lock. The expected-old
# check avoids overwriting a concurrent raw-Git fetch.
finalize_bookmark_push() {
    [ "$BOOKMARK_PUSH_SUCCEEDED" = "1" ] || return 0
    local current expected_zero=0000000000000000000000000000000000000000
    current=$($GIT --git-dir="$GIT_DIR" rev-parse --verify -q "$REMOTE_TRACKING_REF" 2>/dev/null || true)
    if [ "$current" = "$BOOKMARK_PUSH_EXPECTED_OID" ]; then
        if ! $GIT --git-dir="$GIT_DIR" update-ref "$REMOTE_TRACKING_REF" \
            "$BOOKMARK_PUSH_OID" "${current:-$expected_zero}" 2>/dev/null; then
            log WARN "TRACKING-REF-RACE ${SYNC_BM}@${SYNC_REMOTE}: local ref changed after push"
        fi
    elif [ "$current" != "$BOOKMARK_PUSH_OID" ]; then
        log WARN "TRACKING-REF-RACE ${SYNC_BM}@${SYNC_REMOTE}: preserving local ref ${current:-missing} after push"
    fi
    import_tracking_refs >/dev/null 2>&1 || \
        log ERROR "REMOTE-IMPORT-FAIL ${SYNC_BM}@${SYNC_REMOTE}: post-push jj git import failed"
    jj bookmark track "${SYNC_BM}@${SYNC_REMOTE}" 2>/dev/null || true
    log INFO "PUSH-OK ${SYNC_BM}@${SYNC_REMOTE} rev=${BOOKMARK_PUSH_OID} ${BOOKMARK_PUSH_LOG_SUFFIX}"
}

ancestry_class() {
    local local_rev=$1 remote_rev=$2
    if [ "$local_rev" = "$remote_rev" ]; then
        echo equal
    elif jj log -r "$local_rev & ::$remote_rev" --no-graph -T '"y"' 2>/dev/null | grep -q y; then
        echo local-ancestor
    elif jj log -r "$remote_rev & ::$local_rev" --no-graph -T '"y"' 2>/dev/null | grep -q y; then
        echo remote-ancestor
    else
        echo diverged
    fi
}

# Restore the full view because a probe can expose abandoned ancestors.
restore_merge_probe() {
    if ! jj --ignore-working-copy op restore "$2" >/dev/null 2>&1; then
        log CRITICAL "REBASE-PROBE-RESTORE-FAIL $1 operation=$2; skipping push"
        return 1
    fi
}

# Test a merge of both tips before changing bookmarks.
# A clean merge can still hide conflicts in intermediate commits.
handle_diverged() {
    local local_rev=$1 remote_rev=$2
    local probe_change conflict_files pre_probe_op
    # resolve-by-attrs is the .gitattributes-driven auto-resolver. Looked up
    # once here so both the probe-resolution path and the post-rebase path
    # can use it. Empty if not installed — both paths check.
    local resolver="$SCRIPT_DIR/bin/resolve-by-attrs"
    [ -x "$resolver" ] || resolver=""
    pre_probe_op=$(jj op log --no-graph --limit 1 -T 'id' 2>/dev/null)
    if [ -z "$pre_probe_op" ]; then
        log CRITICAL "REBASE-PROBE-FAIL ${SYNC_BM}: could not save the operation before the probe"
        SYNC_CONFLICT=1
        return 0
    fi
    if ! jj new --no-edit "$local_rev" "$remote_rev" -m "rebase-probe" 2>/dev/null; then
        restore_merge_probe "$SYNC_BM" "$pre_probe_op" || true
        log CRITICAL "REBASE-PROBE-FAIL ${SYNC_BM} local=$local_rev remote=$remote_rev; skipping push"
        echo "WARNING: failed to create rebase probe for $SYNC_BM; skipping push" >&2
        SYNC_CONFLICT=1
        return 0
    fi
    probe_change=$(jj log -r 'latest("'"$local_rev"'"+ & "'"$remote_rev"'"+, 1)' --no-graph -T 'change_id' 2>/dev/null | head -1)
    if [ -z "$probe_change" ]; then
        restore_merge_probe "$SYNC_BM" "$pre_probe_op" || true
        log CRITICAL "REBASE-PROBE-FAIL ${SYNC_BM}: could not locate probe commit"
        echo "WARNING: could not locate rebase probe for $SYNC_BM; skipping push" >&2
        SYNC_CONFLICT=1
        return 0
    fi
    if jj log -r "$probe_change" --no-graph -T 'if(conflict, "conflict")' 2>/dev/null | grep -q conflict; then
        conflict_files=$(jj resolve --list -r "$probe_change" 2>/dev/null | awk 'NF {print $1}' | paste -sd, -)
        # Best-effort: try to clear the probe's conflicts via .gitattributes
        # merge=<driver> directives. We pass `-r <probe>` to the resolver so
        # @ stays where it was — using `jj edit` would carry the working-copy
        # snapshot onto the probe and corrupt its content.
        local remaining
        if [ -n "$resolver" ]; then
            "$resolver" -r "$probe_change" >/dev/null 2>&1 || true
            remaining=$(jj resolve --list -r "$probe_change" 2>/dev/null | awk 'NF {print $1}' | paste -sd, -)
        else
            remaining="$conflict_files"
        fi

        if [ -n "$remaining" ]; then
            log ERROR "REBASE-CONFLICT ${SYNC_BM} files=${remaining} local=$local_rev remote=$remote_rev"
            echo "WARNING: rebase has conflicts in ${remaining}; skipping push for $SYNC_BM" >&2
            restore_merge_probe "$SYNC_BM" "$pre_probe_op" || true
            # Mark that the bookmark sync hit a conflict so step_rebase_local_chain
            # doesn't follow up by rebasing the working copy onto the remote tip
            # (that would re-introduce the conflict markers into @- and silently
            # diverge from the snapshot we just pushed).
            SYNC_CONFLICT=1
            return 0
        fi
        log INFO "RESOLVED-BY-ATTRS ${SYNC_BM} files=${conflict_files} (cleared by .gitattributes drivers)"
        # The rebase can create conflicts in intermediate commits.
        # Apply the merge drivers again after the rebase.
    fi
    if ! restore_merge_probe "$SYNC_BM" "$pre_probe_op"; then
        SYNC_CONFLICT=1
        return 0
    fi
    # Save op id so we can rewind if the rebase ends up in a state we can't
    # auto-resolve. Without this, a partial driver resolution would litter
    # the working copy with first-class conflict commits that the user has
    # to clean up manually.
    local pre_rebase_op
    pre_rebase_op=$(jj op log --no-graph --limit 1 -T 'id.short()' 2>/dev/null)
    if ! rebase_with_diagnostics "$SYNC_BM" "$local_rev" "$remote_rev" \
        'roots(::'"$local_rev"' ~ ::'"$remote_rev"')'; then
        echo "WARNING: jj rebase failed for $SYNC_BM; skipping push" >&2
        # Without the flag, step_rebase_local_chain rebases the mutable part of
        # the same chain, and jj records the conflicts in the commits.
        SYNC_CONFLICT=1
        return 0
    fi
    # The rebase does not apply merge drivers. Resolve the oldest commits first.
    # Each resolution can change the conflicts in its descendants.
    local post_change post_remaining
    if [ -n "$resolver" ] && [ -n "$pre_rebase_op" ]; then
        for post_change in $(jj log -r "(${remote_rev}..@-) & conflicts()" --reversed --no-graph -T 'change_id ++ " "' 2>/dev/null); do
            "$resolver" -r "change_id(${post_change}) & (${remote_rev}..@-)" >/dev/null 2>&1 || true
        done
    fi
    post_remaining=$(jj log -r "(${remote_rev}..@-) & conflicts()" --no-graph -T 'change_id.short() ++ " "' 2>/dev/null)
    if [ -n "$post_remaining" ]; then
        log ERROR "REBASE-CONFLICT ${SYNC_BM} changes=${post_remaining% } local=$local_rev remote=$remote_rev (after rebase auto-resolve attempt)"
        echo "WARNING: rebase has conflicts; rewinding and skipping push for $SYNC_BM" >&2
        [ -n "$pre_rebase_op" ] && jj op restore "$pre_rebase_op" 2>/dev/null || true
        SYNC_CONFLICT=1
        return 0
    fi
    # Queue the rebased local tip for the unlocked raw-Git push phase.
    jj bookmark create "$SYNC_BM" -r "@-" 2>/dev/null \
        || jj bookmark set "$SYNC_BM" -r "@-" --allow-backwards 2>/dev/null
    jj bookmark track "${SYNC_BM}@${SYNC_REMOTE}" 2>/dev/null || true
    local rebased_rev
    rebased_rev=$(jj log -r "@-" --no-graph -T 'commit_id' 2>/dev/null)
    queue_bookmark_push "rebased" "$rebased_rev" "$remote_rev" \
        "(rebased local=$local_rev remote=$remote_rev)"
}

# Compare against the imported remote bookmark and prepare any required push.
# This function performs only local jj operations while the lock is held.
prepare_bookmark_sync() {
    [ -n "$SYNC_BM" ] || return 0
    [ "$SYNC_REMOTE_AVAILABLE" = "1" ] || return 0
    [ "$REMOTE_FETCH_OK" = "1" ] || return 0
    local local_rev remote_rev
    local_rev=$(jj log -r "@-" --no-graph -T 'commit_id' 2>/dev/null)
    remote_rev=$(jj log -r "${SYNC_BM}@${SYNC_REMOTE}" --no-graph -T 'commit_id' 2>/dev/null)

    if [ -z "$remote_rev" ]; then
        jj bookmark create "$SYNC_BM" -r "@-" 2>/dev/null \
            || jj bookmark set "$SYNC_BM" -r "@-" --allow-backwards 2>/dev/null
        queue_bookmark_push "new" "$local_rev" "" "(new)"
        return 0
    fi

    case "$(ancestry_class "$local_rev" "$remote_rev")" in
        equal)
            log INFO "SKIP ${SYNC_BM}@${SYNC_REMOTE} already at $remote_rev"
            ;;
        local-ancestor)
            # Remote is ahead of local. The local working copy stays where it
            # is (don't yank @ around without user intent). step_rebase_local
            # below moves any local mutable commits onto the new remote tip.
            log INFO "FAST-FORWARD ${SYNC_BM}@${SYNC_REMOTE} local=$local_rev <- remote=$remote_rev"
            ;;
        remote-ancestor)
            jj bookmark create "$SYNC_BM" -r "@-" 2>/dev/null \
                || jj bookmark set "$SYNC_BM" -r "@-" --allow-backwards 2>/dev/null
            jj bookmark track "${SYNC_BM}@${SYNC_REMOTE}" 2>/dev/null || true
            queue_bookmark_push "ahead" "$local_rev" "$remote_rev" "(ahead)"
            ;;
        diverged)
            handle_diverged "$local_rev" "$remote_rev"
            ;;
    esac
}

# Rebase any local mutable commits between @- and the remote bookmark onto
# the remote bookmark tip. Keeps the local working copy parented on a current
# remote even when the user's @- is behind a fast-forwarded remote.
#
# Skipped when the bookmark sync hit a conflict (SYNC_CONFLICT=1): rebasing
# a conflicting local chain onto the remote would write conflict markers into
# the working copy AND quietly desynchronize @- from the snapshot we already
# pushed. The user should resolve the divergence manually.
step_rebase_local_chain() {
    [ -n "$SYNC_BM" ] || return 0
    [ "$SYNC_REMOTE_AVAILABLE" = "1" ] || return 0
    [ "$REMOTE_FETCH_OK" = "1" ] || return 0
    [ "${SYNC_CONFLICT:-0}" = "1" ] && return 0
    local op before after
    op=$(jj op log --no-graph --limit 1 -T 'id.short()' 2>/dev/null)
    before=$(jj log -r "::@ & conflicts()" --no-graph -T 'change_id ++ "\n"' 2>/dev/null | sort)
    jj rebase -s "roots(mutable() & ::@ ~ ::${SYNC_BM}@${SYNC_REMOTE})" -d "${SYNC_BM}@${SYNC_REMOTE}" 2>/dev/null || return 0
    # jj completes a rebase with conflicts and stores them in the commits. Rewind
    # a rebase that adds a conflict, so that the next run does not push it.
    after=$(jj log -r "::@ & conflicts()" --no-graph -T 'change_id ++ "\n"' 2>/dev/null | sort)
    if [ -n "$(comm -13 <(printf '%s\n' "$before") <(printf '%s\n' "$after") | grep -v '^$')" ]; then
        log ERROR "REBASE-CONFLICT ${SYNC_BM} (local chain onto ${SYNC_BM}@${SYNC_REMOTE}); rebase rewound"
        [ -n "$op" ] && jj op restore "$op" 2>/dev/null || true
    fi
}

# --- Listed-bookmark sync -----------------------------------------------------
# sync.bookmarks = "BOOKMARK@REMOTE ..." names bookmarks that sync_repo fetches,
# fast-forwards, rebases onto the remote when they diverged, and pushes. Unlike
# sync.remote-bookmark, sync_repo never moves them to @-. Transport is the same as
# in the flow above: raw Git without the local lock, jj import and reconcile with it.
# Arrays are indexed by the position of the entry.
declare -a LB_NAME=() LB_REMOTE=() LB_FETCH_URL=() LB_PUSH_URL=() LB_TRACKING_BEFORE=()
declare -a LB_FETCH_OK=() LB_FETCH_OID=() LB_PUSH_OID=() LB_PUSH_EXPECTED=() LB_PUSH_OK=() LB_PUSH_REPLACE=()
LB_HAS_PUSH=0

# Revset of a remote bookmark. Quotes keep names with "/" or "-" literal.
lb_remote_rev() { printf '"%s"@"%s"' "$1" "$2"; }

parse_listed_bookmarks() {
    local entry b r i
    local -a entries=()
    read -ra entries <<<"$1"
    for entry in "${entries[@]}"; do
        b=${entry%@*}
        r=${entry##*@}
        if [ "$entry" = "$b" ] || [ -z "$b" ] || [ -z "$r" ]; then
            log ERROR "BAD-CONFIG sync.bookmarks entry '$entry' must be 'BOOKMARK@REMOTE'"
            exit 1
        fi
        if [ "$b" = "$SYNC_BM" ] && [ "$r" = "$SYNC_REMOTE" ]; then
            log ERROR "BAD-CONFIG sync.bookmarks entry '$entry' is also sync.remote-bookmark"
            exit 1
        fi
        for i in "${!LB_NAME[@]}"; do
            if [ "${LB_NAME[$i]}" = "$b" ] && [ "${LB_REMOTE[$i]}" = "$r" ]; then
                log ERROR "BAD-CONFIG sync.bookmarks has '$entry' twice"
                exit 1
            fi
        done
        LB_NAME+=("$b")
        LB_REMOTE+=("$r")
    done
}

prepare_listed_transport() {
    [ ${#LB_NAME[@]} -gt 0 ] || return 0
    local remotes i b r
    if ! remotes=$(jj git remote list 2>/dev/null); then
        log ERROR "REMOTE-LIST-FAIL sync.bookmarks: jj git remote list failed; skipping listed bookmarks"
        return 0
    fi
    for i in "${!LB_NAME[@]}"; do
        b=${LB_NAME[$i]} r=${LB_REMOTE[$i]}
        LB_FETCH_OK[$i]=0
        if ! printf '%s\n' "$remotes" | awk '{print $1}' | grep -qxF -- "$r"; then
            log INFO "SKIP ${b}@${r}: remote '${r}' not configured"
            continue
        fi
        if ! LB_FETCH_URL[$i]=$($GIT --git-dir="$GIT_DIR" remote get-url "$r" 2>/dev/null); then
            log ERROR "REMOTE-LIST-FAIL ${b}@${r}: git remote URL lookup failed"
            continue
        fi
        LB_PUSH_URL[$i]=$($GIT --git-dir="$GIT_DIR" remote get-url --push "$r" 2>/dev/null || printf '%s' "${LB_FETCH_URL[$i]}")
        LB_TRACKING_BEFORE[$i]=$($GIT --git-dir="$GIT_DIR" rev-parse --verify -q "refs/remotes/${r}/${b}" 2>/dev/null || true)
        LB_FETCH_OK[$i]=1
    done
}

fetch_listed_bookmarks() {
    local i b r output
    for i in "${!LB_NAME[@]}"; do
        [ "${LB_FETCH_OK[$i]:-0}" = "1" ] || continue
        b=${LB_NAME[$i]} r=${LB_REMOTE[$i]}
        if ! output=$(timeout_cmd "fetch-head ${b}@${r}" \
            "$GIT" ls-remote --heads "${LB_FETCH_URL[$i]}" "refs/heads/${b}"); then
            LB_FETCH_OK[$i]=0
            log INFO "SKIP-PUSH ${b}: fetch failed; will retry next run"
            continue
        fi
        LB_FETCH_OID[$i]=$(printf '%s\n' "$output" | awk 'NR == 1 { print $1 }')
        if [ -n "${LB_FETCH_OID[$i]}" ] && ! transfer_cmd "fetch ${b}@${r}" \
            "$GIT" --git-dir="$GIT_DIR" fetch --no-tags --no-write-fetch-head \
            --no-auto-maintenance "${LB_FETCH_URL[$i]}" "refs/heads/${b}"; then
            LB_FETCH_OK[$i]=0
            log INFO "SKIP-PUSH ${b}: fetch failed; will retry next run"
        fi
    done
}

# Publish each fetched tip to its tracking ref, import once, and track the remote
# bookmark so that a missing local bookmark is created from it.
apply_fetched_listed() {
    local i b r ref current any=0 zero=0000000000000000000000000000000000000000
    for i in "${!LB_NAME[@]}"; do
        [ "${LB_FETCH_OK[$i]:-0}" = "1" ] || continue
        b=${LB_NAME[$i]} r=${LB_REMOTE[$i]} ref="refs/remotes/${r}/${b}"
        current=$($GIT --git-dir="$GIT_DIR" rev-parse --verify -q "$ref" 2>/dev/null || true)
        if [ "$current" = "${LB_TRACKING_BEFORE[$i]}" ]; then
            if [ -n "${LB_FETCH_OID[$i]}" ]; then
                $GIT --git-dir="$GIT_DIR" update-ref "$ref" "${LB_FETCH_OID[$i]}" "${current:-$zero}" 2>/dev/null || true
            elif [ -n "$current" ]; then
                $GIT --git-dir="$GIT_DIR" update-ref -d "$ref" "$current" 2>/dev/null || true
            fi
        fi
        any=1
    done
    [ "$any" = "1" ] || return 0
    if ! import_tracking_refs >/dev/null 2>&1; then
        log ERROR "REMOTE-IMPORT-FAIL sync.bookmarks: jj git import failed; skipping listed bookmarks"
        for i in "${!LB_NAME[@]}"; do LB_FETCH_OK[$i]=0; done
        return 0
    fi
    for i in "${!LB_NAME[@]}"; do
        [ "${LB_FETCH_OK[$i]:-0}" = "1" ] || continue
        [ -n "${LB_FETCH_OID[$i]}" ] && jj bookmark track "${LB_NAME[$i]}@${LB_REMOTE[$i]}" >/dev/null 2>&1
        log INFO "FETCH-OK ${LB_NAME[$i]}@${LB_REMOTE[$i]}"
    done
}

# Print the local target of bookmark $1: "N <commit>", "C <commit> <commit>..." when
# conflicted, or nothing when the bookmark does not exist locally.
lb_local_state() {
    jj bookmark list "exact:$1" -T 'if(remote, "", if(conflict, "C " ++ added_targets.map(|c| c.commit_id()).join(" ") ++ "\n", if(present, "N " ++ normal_target.commit_id() ++ "\n", "")))' 2>/dev/null
}

# Print the tip of change $1 above $2. The remote can hold an older commit of the same
# change, so only descendants of the remote tip count.
lb_tip_above() {
    local tip
    tip=$(jj log -r "change_id($1) & $2+::" --no-graph -T 'commit_id ++ "\n"' 2>/dev/null)
    [ "$tip" = "${tip%%$'\n'*}" ] && printf '%s' "$tip"
}

# Rebase the local-only commits of bookmark $1 onto $3. Prints the rebased local tip.
# A merge probe finds most conflicts before the rebase, so the working copy stays as
# it is. resolve-by-attrs clears conflicts that .gitattributes drivers can merge. A
# rebase that still produces conflicted commits is rewound.
lb_rebase() {
    local b=$1 local_rev=$2 remote_rev=$3 pre_op pre_probe_op change new probe c protected mutable_roots
    local sources="roots(${remote_rev}..${local_rev})"
    local -a retained_parents=()
    local resolver="$SCRIPT_DIR/bin/resolve-by-attrs"
    [ -x "$resolver" ] || resolver=""
    pre_probe_op=$(jj op log --no-graph --limit 1 -T 'id' 2>/dev/null)
    if [ -z "$pre_probe_op" ]; then
        log CRITICAL "REBASE-PROBE-FAIL ${b}: could not save the operation before the probe"
        return 1
    fi
    if jj new --no-edit "$local_rev" "$remote_rev" -m "rebase-probe" >/dev/null 2>&1; then
        probe=$(jj log -r "latest(${local_rev}+ & ${remote_rev}+, 1)" --no-graph -T 'change_id ++ "|" ++ if(conflict, "c")' 2>/dev/null)
        if [ -z "${probe%%|*}" ]; then
            restore_merge_probe "$b" "$pre_probe_op" || true
            log CRITICAL "REBASE-PROBE-FAIL ${b}: could not locate probe commit"
            return 1
        fi
        if [ "${probe#*|}" = "c" ] && [ -n "$resolver" ]; then
            "$resolver" -r "${probe%%|*}" >/dev/null 2>&1 || true
            [ -z "$(jj resolve --list -r "${probe%%|*}" 2>/dev/null)" ] && probe="${probe%%|*}|"
        fi
        restore_merge_probe "$b" "$pre_probe_op" || return 1
        if [ "${probe#*|}" = "c" ]; then
            log ERROR "REBASE-CONFLICT ${b} local=$local_rev remote=$remote_rev; push skipped"
            jj bookmark set "$b" -r "$local_rev" --allow-backwards >/dev/null 2>&1
            return 1
        fi
    else
        restore_merge_probe "$b" "$pre_probe_op" || true
        log CRITICAL "REBASE-PROBE-FAIL ${b} local=$local_rev remote=$remote_rev; skipping push"
        return 1
    fi
    pre_op=$(jj op log --no-graph --limit 1 -T 'id.short()' 2>/dev/null)
    change=$(jj log -r "$local_rev" --no-graph -T 'change_id' 2>/dev/null)
    protected=$(jj log -r "heads((${remote_rev}..${local_rev}) & immutable())" \
        --no-graph -T 'commit_id ++ " "' 2>/dev/null)
    if [ -n "$protected" ]; then
        mutable_roots=$(jj log -r "roots((${remote_rev}..${local_rev}) & mutable())" \
            --no-graph -T 'commit_id ++ "|"' 2>/dev/null)
        if [ -n "$mutable_roots" ]; then
            # Retain upstream history as merge parents instead of rewriting it.
            sources=${mutable_roots%|}
            for c in $protected; do retained_parents+=(-d "$c"); done
        fi
    fi
    if ! rebase_with_diagnostics "$b" "$local_rev" "$remote_rev" \
        "$sources" "${retained_parents[@]}" >/dev/null; then
        return 1
    fi
    new=$(lb_tip_above "$change" "$remote_rev")
    if [ -n "$new" ] && [ -n "$resolver" ]; then
        # The rebase does not apply merge drivers. Resolve the oldest commits first,
        # because jj rebases the descendants of each resolved commit.
        for c in $(jj log -r "(${remote_rev}..${new}) & conflicts()" --reversed --no-graph -T 'change_id ++ " "' 2>/dev/null); do
            "$resolver" -r "$c" >/dev/null 2>&1 || true
        done
        new=$(lb_tip_above "$change" "$remote_rev")
    fi
    if [ -z "$new" ] || [ -n "$(jj log -r "(${remote_rev}..${new}) & conflicts()" --no-graph -T '"y"' 2>/dev/null)" ]; then
        log ERROR "REBASE-CONFLICT ${b} local=$local_rev remote=$remote_rev; rewound, push skipped"
        [ -n "$pre_op" ] && jj op restore "$pre_op" >/dev/null 2>&1
        # The import can leave the bookmark conflicted. Keep the local side for the manual merge.
        jj bookmark set "$b" -r "$local_rev" --allow-backwards >/dev/null 2>&1
        return 1
    fi
    printf '%s' "$new"
}

# Require rewrite history for each remote-only commit except empty intermediate merges.
# Keep the remote tip in this check, even when it is an empty merge.
lb_supersedes() {
    local local_rev=$1 remote_rev=$2 remote_only predecessors
    remote_only=$(jj log -r "(${local_rev}..${remote_rev}) ~ ((merges() & empty()) ~ ${remote_rev})" \
        --no-graph -T 'commit_id ++ "\n"' 2>/dev/null) || return 1
    [ -n "$remote_only" ] || return 1
    predecessors=$(jj evolog -r "${remote_rev}..${local_rev}" --no-graph -T 'commit.commit_id() ++ "\n"' 2>/dev/null) || return 1
    [ -z "$(comm -23 <(printf '%s\n' "$remote_only" | sort -u) <(printf '%s\n' "$predecessors" | sort -u))" ]
}

reconcile_listed_bookmarks() {
    local i b r rr state kind local_rev remote_rev c range undescribed conflicted with_conflicts
    for i in "${!LB_NAME[@]}"; do
        [ "${LB_FETCH_OK[$i]:-0}" = "1" ] || continue
        b=${LB_NAME[$i]} r=${LB_REMOTE[$i]} rr=$(lb_remote_rev "$b" "$r")
        remote_rev=$(jj log -r "present($rr)" --no-graph -T 'commit_id' 2>/dev/null)
        state=$(lb_local_state "$b")
        kind=${state%% *}
        local_rev="" conflicted=0
        case "$kind" in
            N) local_rev=${state#N } ;;
            C)
                conflicted=1
                # jj merged a local move and a remote move. Keep the side that is not the remote.
                for c in ${state#C }; do
                    [ "$c" = "$remote_rev" ] || local_rev=${local_rev:+$local_rev }$c
                done
                if [ -z "$local_rev" ] || [ "$local_rev" != "${local_rev% *}" ]; then
                    log ERROR "BOOKMARK-CONFLICT ${b}: targets ${state#C }; resolve with jj bookmark set"
                    continue
                fi
                ;;
            *)
                if [ -n "$remote_rev" ]; then
                    jj bookmark set "$b" -r "$remote_rev" >/dev/null 2>&1
                    log INFO "FAST-FORWARD ${b}@${r} created local bookmark at $remote_rev"
                fi
                continue
                ;;
        esac

        if [ -n "$remote_rev" ]; then
            case "$(ancestry_class "$local_rev" "$remote_rev")" in
                equal)
                    [ "$conflicted" = "1" ] && jj bookmark set "$b" -r "$remote_rev" --allow-backwards >/dev/null 2>&1
                    log INFO "SKIP ${b}@${r} already at $remote_rev"
                    continue
                    ;;
                local-ancestor)
                    jj bookmark set "$b" -r "$remote_rev" --allow-backwards >/dev/null 2>&1
                    log INFO "FAST-FORWARD ${b}@${r} local=$local_rev <- remote=$remote_rev"
                    continue
                    ;;
                diverged)
                    if lb_supersedes "$local_rev" "$remote_rev"; then
                        LB_PUSH_REPLACE[$i]=1
                        log INFO "REWRITTEN ${b}@${r} local=$local_rev replaces remote=$remote_rev"
                    else
                        local_rev=$(lb_rebase "$b" "$local_rev" "$remote_rev") || continue
                    fi
                    ;;
            esac
            jj bookmark set "$b" -r "$local_rev" --allow-backwards >/dev/null 2>&1
            range="${remote_rev}..${local_rev}"
        else
            # A new bookmark: check only commits that no remote has, not all upstream history.
            range="::${local_rev} ~ ::remote_bookmarks() ~ root()"
        fi

        # Servers such as gitfarm reject commits without a description. Do not rewrite them here.
        undescribed=$(jj log -r "$range" --no-graph -T 'if(!description, change_id.short() ++ " ")' 2>/dev/null)
        if [ -n "$undescribed" ]; then
            log ERROR "SKIP-PUSH ${b}@${r}: commits without description: ${undescribed% }"
            continue
        fi
        with_conflicts=$(jj log -r "$local_rev & conflicts()" --no-graph -T '"c"' 2>/dev/null)
        if [ -n "$with_conflicts" ]; then
            log ERROR "SKIP-PUSH ${b}@${r}: the commit to push has a conflict ($local_rev)"
            continue
        fi
        LB_PUSH_OID[$i]=$local_rev
        LB_PUSH_EXPECTED[$i]=$remote_rev
        LB_HAS_PUSH=1
    done
}

push_listed_bookmarks() {
    local i tag ref current
    for i in "${!LB_NAME[@]}"; do
        [ -n "${LB_PUSH_OID[$i]:-}" ] || continue
        tag="${LB_NAME[$i]}@${LB_REMOTE[$i]}" ref="refs/heads/${LB_NAME[$i]}"
        if [ "${LB_PUSH_REPLACE[$i]:-0}" = "1" ]; then
            # gitfarm rejects force pushes, and delete+push has no lease. Check the remote tip immediately before.
            current=$(timeout_cmd "lease $tag" "$GIT" ls-remote --heads "${LB_PUSH_URL[$i]}" "$ref") || continue
            if [ "${current%%[[:space:]]*}" != "${LB_PUSH_EXPECTED[$i]}" ]; then
                log INFO "SKIP-PUSH ${tag}: remote moved after fetch; will retry next run"
                continue
            fi
            push_force_replace "$tag" "${LB_PUSH_URL[$i]}" "${LB_PUSH_OID[$i]}" \
                "$ref" "${LB_PUSH_EXPECTED[$i]}" && LB_PUSH_OK[$i]=1
        elif transfer_cmd "push $tag" \
            env GIT_ALTERNATE_OBJECT_DIRECTORIES="$GIT_DIR/objects" \
            "$GIT" --git-dir="$PUSH_GIT_DIR" push "${LB_PUSH_URL[$i]}" \
            "${LB_PUSH_OID[$i]}:refs/heads/${LB_NAME[$i]}"; then
            LB_PUSH_OK[$i]=1
        fi
    done
}

finalize_listed_bookmarks() {
    local i b r ref current any=0 zero=0000000000000000000000000000000000000000
    for i in "${!LB_NAME[@]}"; do
        [ "${LB_PUSH_OK[$i]:-0}" = "1" ] || continue
        b=${LB_NAME[$i]} r=${LB_REMOTE[$i]} ref="refs/remotes/${r}/${b}"
        current=$($GIT --git-dir="$GIT_DIR" rev-parse --verify -q "$ref" 2>/dev/null || true)
        if [ "$current" = "${LB_PUSH_EXPECTED[$i]}" ]; then
            $GIT --git-dir="$GIT_DIR" update-ref "$ref" "${LB_PUSH_OID[$i]}" "${current:-$zero}" 2>/dev/null ||
                log WARN "TRACKING-REF-RACE ${b}@${r}: local ref changed after push"
        elif [ "$current" != "${LB_PUSH_OID[$i]}" ]; then
            log WARN "TRACKING-REF-RACE ${b}@${r}: preserving local ref ${current:-missing} after push"
        fi
        any=1
    done
    [ "$any" = "1" ] || return 0
    import_tracking_refs >/dev/null 2>&1 ||
        log ERROR "REMOTE-IMPORT-FAIL sync.bookmarks: post-push jj git import failed"
    for i in "${!LB_NAME[@]}"; do
        [ "${LB_PUSH_OK[$i]:-0}" = "1" ] || continue
        jj bookmark track "${LB_NAME[$i]}@${LB_REMOTE[$i]}" >/dev/null 2>&1 || true
        log INFO "PUSH-OK ${LB_NAME[$i]}@${LB_REMOTE[$i]} rev=${LB_PUSH_OID[$i]}"
    done
}

# --- main ---------------------------------------------------------------------
log INFO "START"

# Read sync configuration. Both keys are independently optional:
#   sync.remote-bookmark = "BOOKMARK@REMOTE"   (e.g. "main@backup")
#     Drives the bookmark-sync flow: raw Git transport plus locked jj import
#     and reconciliation.
#   sync.snapshot-url    = "git@server:path"
#     Drives the per-host snapshot flow: raw git push to URL with no jj
#     remote tracking. Snapshots happen FIRST so they always land before
#     the bookmark-sync flow makes any local changes.
SYNC_BM=""
SYNC_REMOTE=""
remote_bookmark=$(jj config get sync.remote-bookmark 2>/dev/null || true)
if [ -n "$remote_bookmark" ]; then
    case "$remote_bookmark" in
        *@*)
            SYNC_BM="${remote_bookmark%@*}"
            SYNC_REMOTE="${remote_bookmark##*@}"
            ;;
        *)
            log ERROR "BAD-CONFIG sync.remote-bookmark='$remote_bookmark' must be 'BOOKMARK@REMOTE' format"
            exit 1
            ;;
    esac
    if [ -z "$SYNC_BM" ] || [ -z "$SYNC_REMOTE" ]; then
        log ERROR "BAD-CONFIG sync.remote-bookmark='$remote_bookmark' has empty bookmark or remote"
        exit 1
    fi
fi
SNAPSHOT_URL=$(jj config get sync.snapshot-url 2>/dev/null || true)
#   sync.bookmarks       = "BOOKMARK@REMOTE ..."
#     Bookmarks synced as they are: fetch, fast-forward or rebase, push. See
#     "Listed-bookmark sync" above.
parse_listed_bookmarks "$(jj config get sync.bookmarks 2>/dev/null || true)"

resolve_git_dir
prepare_push_transport
trap cleanup_push_transport EXIT
cleanup_stale_tmp_packs

# --- repo health gate ----------------------------------------------------------
# The `jj root` gate at the top passes even when the store is corrupted
# (missing object, unreadable index) — it only resolves the workspace path.
# Every index-loading call below, however, fails; their stderr is either
# discarded (`2>/dev/null || true`) or misread as benign (empty `jj git
# remote list` output looks like "remote not configured" → INFO skip). The
# run then ends INFO-only: no ERROR, no notification, and no snapshot
# safety-net push — a silent backup outage. Probe the index once, loudly.
# --ignore-working-copy keeps the probe read-only (no snapshot side effect).
step_check_repo_health() {
    local err rc
    err=$(mktemp "/tmp/sync_repo_err.XXXXXX")
    jj log -r @ --no-graph --ignore-working-copy -T '""' >/dev/null 2>"$err"
    rc=$?
    if [ $rc -ne 0 ]; then
        log ERROR "REPO-LOAD-FAIL (rc=$rc): $(_summarize_stderr "$err") -- sync AND snapshot backup skipped until the repo is repaired"
        if [ -s "$err" ]; then
            log DEBUG "STDERR-BEGIN repo-health"
            while IFS= read -r _stderr_line; do
                log DEBUG "  $_stderr_line"
            done < "$err"
            log DEBUG "STDERR-END repo-health"
        fi
        cat "$err" >&2
        rm -f "$err"
        exit 1
    fi
    rm -f "$err"
}
step_check_repo_health

# --- free-space gate ------------------------------------------------------------
# On 2026-11-01 the disk was full during a run. Each write was short or empty, and
# home-template and jj recorded empty files in commits that sync_repo then pushed.
# Do not start the local work without the space for it. Check the workspace, the
# Git store, and the directory of temporary files.
step_check_free_space() {
    local min_kb=$((SYNC_REPO_MIN_FREE_MB * 1024)) dir avail
    for dir in "$PWD" "$LOCK_PATH" "${TMPDIR:-/tmp}"; do
        avail=$(df -Pk -- "$dir" 2>/dev/null | awk 'NR == 2 {print $4}')
        [[ $avail =~ ^[0-9]+$ ]] || continue
        if [ "$avail" -lt "$min_kb" ]; then
            log ERROR "LOW-DISK $dir has $((avail / 1024)) MiB free (minimum $SYNC_REPO_MIN_FREE_MB MiB) -- sync skipped"
            exit 1
        fi
    done
}
step_check_free_space

# --- imported snapshot refs ------------------------------------------------------
# Snapshots are refs/heads/<host>/* at sync.snapshot-url. When a jj remote has the
# same URL, `jj git fetch` and pushes before 2026-11 copy them to
# refs/remotes/<remote>/<host>/*. jj imports these as untracked remote bookmarks.
# Such bookmarks are immutable heads, so the whole local chain becomes immutable,
# and `jj describe` and the rebase fail. An old snapshot also keeps the earlier
# versions of rewritten commits visible, and jj shows them as divergent.
# Remove these refs and import the removal. The snapshots on the server stay.
step_forget_snapshot_tracking_refs() {
    [ -n "$SNAPSHOT_URL" ] || return 0
    local key url remote host list n
    list=$(mktemp "/tmp/sync_repo_refs.XXXXXX") || return 0
    while read -r key url; do
        [ "$url" = "$SNAPSHOT_URL" ] || continue
        remote=${key#remote.}
        remote=${remote%.url}
        # Each host writes <host>/_repo-history, and the default workspace writes
        # <host>/default. Other names under refs/remotes are real bookmarks.
        while IFS= read -r host; do
            [ -n "$host" ] || continue
            "$GIT" --git-dir="$GIT_DIR" for-each-ref --format='delete %(refname) %(objectname)' \
                "refs/remotes/$remote/$host/" >>"$list"
        done < <(
            {
                printf '%s\n' "$MACHINE_NAME"
                "$GIT" --git-dir="$GIT_DIR" for-each-ref --format='%(refname)' "refs/remotes/$remote/" |
                    awk -v p="refs/remotes/$remote/" 'index($0, p) == 1 {
                        n = split(substr($0, length(p) + 1), part, "/")
                        if (n == 2 && (part[2] == "_repo-history" || part[2] == "default")) print part[1]
                    }'
            } | sort -u
        )
    done < <("$GIT" --git-dir="$GIT_DIR" config --get-regexp '^remote\..*\.url$' 2>/dev/null)
    n=$(wc -l <"$list")
    if [ "$n" -gt 0 ]; then
        if "$GIT" --git-dir="$GIT_DIR" update-ref --stdin <"$list" &&
            jj --ignore-working-copy git import >/dev/null 2>&1; then
            log INFO "SNAPSHOT-REF-CLEANUP removed $n imported snapshot ref(s)"
        else
            log WARN "SNAPSHOT-REF-CLEANUP failed; imported snapshot refs can make local commits immutable"
        fi
    fi
    rm -f "$list"
}
step_forget_snapshot_tracking_refs

jj workspace update-stale 2>/dev/null || true

if ! run_sync_hook pre-snapshot; then
    log ERROR "ABORT: sync.pre-snapshot failed before snapshot creation"
    exit 1
fi

# Only repositories that push need portable content. The capture step must come
# before the first snapshot, so that the home directory never enters a commit.
if [ -n "$SYNC_BM" ] || [ -n "$SNAPSHOT_URL" ] || [ ${#LB_NAME[@]} -gt 0 ]; then
    if ! run_home_template capture; then
        log ERROR "ABORT: home-template capture failed before snapshot creation"
        exit 1
    fi
fi

# Surface files that jj refuses to snapshot (size limit). Those files
# silently bypass the whole sync — flag them as ERROR so the user can
# either delete or raise snapshot.max-new-file-size per repo.
check_refused_snapshots

snapshot_at_to_push_rev

# No push target configured: finalize the work locally and stop. Committing
# WIP and giving it a description is worth doing on its own — it's what makes
# `jj log` readable and the repo push-ready — and needs no remote. Everything
# past this point exists to serve a push, so it stays behind the gate.
if [ -z "$SYNC_BM" ] && [ -z "$SNAPSHOT_URL" ] && [ ${#LB_NAME[@]} -eq 0 ]; then
    step_describe_local_chain
    log INFO "NO-SYNC-CONFIG: committed and described locally; none of sync.remote-bookmark, sync.snapshot-url, sync.bookmarks set"
    exit 0
fi

resolve_workspace_name

step_describe_local_chain
prepare_snapshot_refs
prepare_repo_history
prepare_remote_transport
prepare_listed_transport

# All remaining work in this phase is network-only. Interactive jj commands
# can run while snapshots and remote objects transfer.
release_local_lock

# CRITICAL ORDER: snapshot push FIRST. Whatever the user had when the immutable
# commit IDs were captured is backed up before reconciliation can rewrite it.
load_snapshot_remote_refs || true
push_prepared_snapshots
push_repo_history
fetch_repo_history
fetch_remote_bookmark_objects
fetch_listed_bookmarks

# Import the fetched Git ref and perform all jj reconciliation under the short
# local-state lock. Any push is represented by an immutable commit ID before
# the lock is released again.
acquire_local_lock
apply_fetched_remote
apply_fetched_listed
# Before prepare_bookmark_sync: a rebase of a listed bookmark can rewrite @-.
reconcile_listed_bookmarks
prepare_bookmark_sync

if [ -n "$BOOKMARK_PUSH_OID" ] || [ "$LB_HAS_PUSH" = "1" ]; then
    release_local_lock
    push_prepared_bookmark
    push_listed_bookmarks
    acquire_local_lock
    finalize_bookmark_push
    finalize_listed_bookmarks
fi

final_rc=0
step_rebase_local_chain
run_home_template render || final_rc=1
run_sync_hook post-update || final_rc=1
release_local_lock
exit "$final_rc"
