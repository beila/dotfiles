+static void SetWallpaperBackground(Window window, const Monitor *monitor,
+                                   int x, int y, int w, int h) {
+  if (auth_background_image == NULL || w <= 0 || h <= 0) {
+    return;
+  }
+
+  imlib_context_set_image(auth_background_image);
+  int image_w = imlib_image_get_width();
+  int image_h = imlib_image_get_height();
+  double scale_x = (double)monitor->width / image_w;
+  double scale_y = (double)monitor->height / image_h;
+  double scale = scale_x < scale_y ? scale_x : scale_y;
+  int fit_w = (int)(image_w * scale);
+  int fit_h = (int)(image_h * scale);
+  if (fit_w < 1 || fit_h < 1) {
+    return;
+  }
+  int image_x = monitor->x + (monitor->width - fit_w) / 2;
+  int image_y = monitor->y + (monitor->height - fit_h) / 2;
+  int left = x > image_x ? x : image_x;
+  int top = y > image_y ? y : image_y;
+  int right = x + w < image_x + fit_w ? x + w : image_x + fit_w;
+  int bottom = y + h < image_y + fit_h ? y + h : image_y + fit_h;
+
+  Pixmap background = XCreatePixmap(display, window, w, h,
+                                    DefaultDepth(display, DefaultScreen(display)));
+  XGCValues values = {0};
+  values.foreground = xcolor_background.pixel;
+  GC gc = XCreateGC(display, background, GCForeground, &values);
+  XFillRectangle(display, background, gc, 0, 0, w, h);
+  XFreeGC(display, gc);
+
+  if (left < right && top < bottom) {
+    unsigned char red[256], green[256], blue[256];
+    for (int c = 0; c < 256; ++c) {
+      red[c] = (c * (100 - auth_background_opacity) +
+                (xcolor_background.red / 257) * auth_background_opacity) / 100;
+      green[c] = (c * (100 - auth_background_opacity) +
+                  (xcolor_background.green / 257) * auth_background_opacity) / 100;
+      blue[c] = (c * (100 - auth_background_opacity) +
+                 (xcolor_background.blue / 257) * auth_background_opacity) / 100;
+    }
+    imlib_context_set_display(display);
+    imlib_context_set_visual(DefaultVisual(display, DefaultScreen(display)));
+    imlib_context_set_colormap(DefaultColormap(display, DefaultScreen(display)));
+    imlib_context_set_drawable(background);
+    imlib_context_set_color_modifier(imlib_create_color_modifier());
+    imlib_set_color_modifier_tables(red, green, blue, NULL);
+    imlib_render_image_part_on_drawable_at_size(
+        (left - image_x) * image_w / fit_w,
+        (top - image_y) * image_h / fit_h,
+        ((right - left) * image_w + fit_w - 1) / fit_w,
+        ((bottom - top) * image_h + fit_h - 1) / fit_h,
+        left - x, top - y, right - left, bottom - top);
+    imlib_free_color_modifier();
+    imlib_context_set_color_modifier(NULL);
+  }
+
+  // Use the wallpaper pixels so the desktop stays covered.
+  XSetWindowBackgroundPixmap(display, window, background);
+  XFreePixmap(display, background);
+}
