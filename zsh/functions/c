#!env zsh
setopt localoptions pipefail
if [[ -n "${ZMX_SESSION-}" && ( -n "${SSH_CONNECTION-}" || -n "${SSH_TTY-}" ) ]]; then
  "${DOTFILES_ROOT:-$HOME/.dotfiles}/bin/clipboard-bridge" copy "$@"
  return
fi
local -a provider
if [[ -n "${WAYLAND_DISPLAY-}" ]] && (( ${+commands[wl-copy]} )); then
  provider=(wl-copy)
elif [[ -n "${DISPLAY-}" ]] && (( ${+commands[xclip]} )); then
  provider=(xclip -selection clipboard -in)
elif (( ${+commands[pbcopy]} )); then
  provider=(pbcopy)
elif (( ${+commands[clip.exe]} )); then
  provider=(clip.exe)
else
  print -u2 -- 'c: no local clipboard provider is available'
  return 1
fi
if (( $# )); then
  cat -- "$@" | "${provider[@]}"
else
  "${provider[@]}"
fi
